<UserControl x:Class="NetGuardian.App.Tests.Fixtures.CompiledSectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NetGuardian.App.Views;assembly=NetGuardian">
    <StackPanel>
        <CheckBox x:Name="FilterSource" Content="仅显示新网络" Visibility="Collapsed" />
        <Expander IsExpanded="True" Style="{DynamicResource WifiSectionExpanderStyle}">
            <Expander.Header>
                <views:ListSectionHeader x:Name="SectionHeader">
                    <views:ListSectionHeader.Heading>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="周围网络" VerticalAlignment="Center" />
                            <Border Style="{DynamicResource SectionCountBadgeStyle}">
                                <TextBlock x:Name="CountText" Text="{Binding Items.Count, ElementName=Networks}" />
                            </Border>
                        </DockPanel>
                    </views:ListSectionHeader.Heading>
                    <views:ListSectionHeader.Tools>
                        <Button x:Name="FilterButton" Tag="{Binding ElementName=FilterSource}" />
                    </views:ListSectionHeader.Tools>
                </views:ListSectionHeader>
            </Expander.Header>
            <DataGrid x:Name="Networks" AutoGenerateColumns="False" CanUserAddRows="False" Height="100" />
        </Expander>
    </StackPanel>
</UserControl>
