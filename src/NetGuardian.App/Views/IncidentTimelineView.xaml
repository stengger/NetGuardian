<UserControl x:Class="NetGuardian.App.Views.IncidentTimelineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontBody}"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <!-- 仅用于故障记录，复用主题令牌，避免系统默认的直角实色选中条。 -->
        <Style x:Key="IncidentHistoryRowStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="{DynamicResource StrokeControlThickness}" />
            <Setter Property="Padding" Value="{DynamicResource SpacingControlPadding}" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="IncidentRowSurface" CornerRadius="{DynamicResource CornerCard}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border x:Name="ObservabilityCard" Style="{DynamicResource SectionBorderStyle}" Margin="{DynamicResource SpacingGroupGap}">
                <StackPanel>
                    <TextBlock x:Name="ObservabilityHeading" Text="可用性与质量基线概览" Style="{DynamicResource SectionTitleStyle}" />
                    <Grid Margin="{DynamicResource SpacingFieldGap}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock x:Name="Obs7dLabel" Text="近 7 天可用率" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="Obs7dValue" Text="100.00%" FontSize="{DynamicResource FontSection}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock x:Name="Obs30dLabel" Text="近 30 天可用率" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="Obs30dValue" Text="100.00%" FontSize="{DynamicResource FontSection}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock x:Name="ObsMttrLabel" Text="平均恢复 (MTTR)" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ObsMttrValue" Text="—" FontSize="{DynamicResource FontSection}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock x:Name="ObsLongestLabel" Text="最长中断 / 恢复率" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="ObsLongestValue" Text="— / 100%" FontSize="{DynamicResource FontSection}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="{DynamicResource SpacingFieldGap}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock x:Name="ObsTrendHeading" Text="近期网络延迟趋势 (HTTPS)" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBlock x:Name="ObsTrendMetricsText" Text="—" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="{DynamicResource CornerCard}" Padding="6,4" MinHeight="64">
                                <Canvas x:Name="LatencyTrendCanvas" Height="56" ClipToBounds="True" SizeChanged="LatencyTrendCanvas_SizeChanged">
                                    <Polyline x:Name="LatencyTrendLine" Stroke="{DynamicResource AccentTextFillColorPrimaryBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                </Canvas>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="ObsWifiRankingHeading" Text="Wi-Fi 稳定性排行" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBlock x:Name="ObsWifiRankingText" Text="近 7 天暂无断网 Wi-Fi 统计" FontSize="{DynamicResource FontCaption}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock x:Name="EmptyText" Text="暂无故障记录" TextWrapping="Wrap" />
            <StackPanel x:Name="HistoryDetails" Visibility="Collapsed">
                <Border Style="{DynamicResource SectionBorderStyle}" Margin="{DynamicResource SpacingGroupGap}">
                    <StackPanel>
                        <TextBlock x:Name="HistoryHeading" Text="历史故障" Style="{DynamicResource SectionTitleStyle}" />
                        <ListBox x:Name="HistoryList" AutomationProperties.Name="故障时间与恢复结果"
                                HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                MaxHeight="232" SelectionChanged="HistorySelectionChanged"
                                Background="Transparent" BorderThickness="0" Padding="0"
                                ItemContainerStyle="{StaticResource IncidentHistoryRowStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Title}" TextWrapping="Wrap" /></DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource SectionBorderStyle}" Margin="{DynamicResource SpacingGroupGap}">
                    <StackPanel>
                        <TextBlock x:Name="TimelineHeading" Text="本次故障经过" Style="{DynamicResource SectionTitleStyle}" />
                        <TextBlock x:Name="CountsText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="{DynamicResource SpacingFieldGap}" />
                        <ItemsControl x:Name="StepsList" AutomationProperties.Name="故障步骤">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding}" Margin="0,3" TextWrapping="Wrap" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Expander x:Name="RawDetails" Header="原始记录与探针证据" Margin="0,8,0,0" Expanded="RawExpanded">
                    <TextBox x:Name="RawText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="260"
                            AutomationProperties.Name="原始故障记录" VerticalScrollBarVisibility="Auto" />
                </Expander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
