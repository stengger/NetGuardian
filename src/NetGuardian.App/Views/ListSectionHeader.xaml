<UserControl x:Class="NetGuardian.App.Views.ListSectionHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NetGuardian.App.Views"
             Focusable="False" UseLayoutRounding="True">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="VisibilityConverter" /></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ContentPresenter Height="{DynamicResource ToolbarControlHeight}" Margin="{DynamicResource WifiHeaderHeadingInset}"
                          Content="{Binding Heading, RelativeSource={RelativeSource AncestorType=views:ListSectionHeader}}" VerticalAlignment="Center" />
        <ContentPresenter Grid.Row="1" Margin="{DynamicResource WifiSectionContentGap}"
                          Content="{Binding Tools, RelativeSource={RelativeSource AncestorType=views:ListSectionHeader}}"
                          Visibility="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=views:ListSectionHeader}, Converter={StaticResource VisibilityConverter}}" />
    </Grid>
</UserControl>
