<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:NetGuardian.App.Views">
    <BooleanToVisibilityConverter x:Key="SectionExpandedVisibility" />
    <Style TargetType="views:ListSectionHeader">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="views:ListSectionHeader">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ContentPresenter Height="{DynamicResource ToolbarControlHeight}" Margin="{DynamicResource WifiHeaderHeadingInset}" Content="{TemplateBinding Heading}" VerticalAlignment="Center" />
                <ContentPresenter Grid.Row="1" Margin="{DynamicResource WifiSectionContentGap}" Content="{TemplateBinding Tools}" Visibility="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource SectionExpandedVisibility}}" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
