<UserControl x:Class="NetGuardian.App.Views.SpeedTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" UseLayoutRounding="True" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontBody}">
    <UserControl.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSpeedMetric}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style x:Key="MetricUnit" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="{DynamicResource SpacingMetricUnit}" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ContentControl x:Name="InlineActionsHost" HorizontalContentAlignment="Stretch">
            <WrapPanel>
                <Button x:Name="RunButton" Style="{DynamicResource PrimaryButtonStyle}" Click="Run_Click" FontWeight="SemiBold" Margin="{DynamicResource SpacingItemGap}" />
                <Button x:Name="CancelButton" Style="{DynamicResource SecondaryButtonStyle}" Click="Cancel_Click" Margin="{DynamicResource SpacingItemGap}" Visibility="Collapsed" />
                <Button x:Name="CopyButton" Style="{DynamicResource SecondaryButtonStyle}" Click="Copy_Click" IsEnabled="False" Margin="{DynamicResource SpacingItemGap}" />
            </WrapPanel>
        </ContentControl>
        <Grid Grid.Row="1" Margin="{DynamicResource SpacingGroupGap}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="{DynamicResource SpacingInlineGroupGap}">
                <TextBlock x:Name="TitleText" FontSize="{DynamicResource FontMetric}" FontWeight="SemiBold" />
                <TextBlock x:Name="IntroText" Style="{StaticResource Secondary}" Margin="{DynamicResource SpacingBlockStart}" />
            </StackPanel>
        </Grid>

        <Grid x:Name="MetricsGrid" Grid.Row="2" Margin="{DynamicResource SpacingMetricsArea}" SizeChanged="ContentPanel_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Border x:Name="DownloadCard" Style="{DynamicResource SectionBorderStyle}" Margin="{DynamicResource SpacingMetricGap}">
                <StackPanel>
                    <TextBlock x:Name="DownloadLabel" Foreground="{DynamicResource SpeedDownloadBrush}" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="{DynamicResource SpacingMetricLine}">
                        <TextBlock x:Name="DownloadValue" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="Mbps" Style="{StaticResource MetricUnit}" />
                    </StackPanel>
                    <TextBlock x:Name="DownloadState" Style="{StaticResource Secondary}" />
                    <TextBlock x:Name="DownloadHint" Style="{StaticResource Secondary}" Margin="{DynamicResource SpacingGroupStart}" />
                </StackPanel>
            </Border>
            <Border x:Name="UploadCard" Grid.Column="1" Style="{DynamicResource SectionBorderStyle}" Margin="{DynamicResource SpacingMetricGap}">
                <StackPanel>
                    <TextBlock x:Name="UploadLabel" Foreground="{DynamicResource SpeedUploadBrush}" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="{DynamicResource SpacingMetricLine}">
                        <TextBlock x:Name="UploadValue" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="Mbps" Style="{StaticResource MetricUnit}" />
                    </StackPanel>
                    <TextBlock x:Name="UploadState" Style="{StaticResource Secondary}" />
                    <TextBlock x:Name="UploadHint" Style="{StaticResource Secondary}" Margin="{DynamicResource SpacingGroupStart}" />
                </StackPanel>
            </Border>
            <Border x:Name="ResponseCard" Grid.Column="2" Style="{DynamicResource SectionBorderStyle}">
                <StackPanel>
                    <TextBlock x:Name="ResponseLabel" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Margin="{DynamicResource SpacingMetricLine}">
                        <TextBlock x:Name="ResponseValue" Style="{StaticResource MetricValue}" />
                        <TextBlock Text="ms" Style="{StaticResource MetricUnit}" />
                    </StackPanel>
                    <TextBlock x:Name="ResponseState" Style="{StaticResource Secondary}" />
                    <TextBlock x:Name="ResponseHint" Style="{StaticResource Secondary}" Margin="{DynamicResource SpacingGroupStart}" />
                </StackPanel>
            </Border>
        </Grid>


        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False"
                      Padding="{DynamicResource SpacingItemGap}" Focusable="False">
            <StackPanel x:Name="ContentPanel" Margin="{DynamicResource SpacingHairlineStart}">


                <Border x:Name="ProcessCard" Style="{DynamicResource SectionBorderStyle}" Margin="{DynamicResource SpacingGroupGap}">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="ElapsedText" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Margin="{DynamicResource SpacingElapsedTime}" />
                            <TextBlock x:Name="StatusText" FontSize="{DynamicResource FontSection}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                        <TextBlock x:Name="StatusHint" Style="{StaticResource Secondary}" Margin="{DynamicResource SpacingProcessHint}" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="{DynamicResource SpacingTrailingGroupGap}">
                                <TextBlock x:Name="ResponseStepLabel" FontWeight="SemiBold" />
                                <TextBlock x:Name="ResponseStepState" Style="{StaticResource Secondary}" Margin="{DynamicResource SpacingValidationGap}" />
                            </StackPanel>
                            <StackPanel Margin="{DynamicResource SpacingTrailingGroupGap}">
                                <TextBlock x:Name="DownloadStepLabel" FontWeight="SemiBold" />
                                <TextBlock x:Name="DownloadStepState" Style="{StaticResource Secondary}" Margin="{DynamicResource SpacingValidationGap}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="UploadStepLabel" FontWeight="SemiBold" />
                                <TextBlock x:Name="UploadStepState" Style="{StaticResource Secondary}" Margin="{DynamicResource SpacingValidationGap}" />
                            </StackPanel>
                        </UniformGrid>
                        <ProgressBar x:Name="RunningIndicator" Height="3" IsIndeterminate="True" Foreground="{DynamicResource SpeedDownloadBrush}"
                                     Margin="{DynamicResource SpacingGroupStart}" Visibility="Collapsed" AutomationProperties.Name="" />
                        <TextBlock x:Name="CheckedAtText" Style="{StaticResource Secondary}" Margin="{DynamicResource SpacingGroupStart}" />
                        <Expander Style="{DynamicResource ContentExpanderStyle}" x:Name="FailureExpander" Visibility="Collapsed" Margin="{DynamicResource SpacingSectionStart}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <TextBox x:Name="FailureText" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalScrollBarVisibility="Disabled" />
                        </Expander>
                    </StackPanel>
                </Border>

                <Border Style="{DynamicResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="MethodTitle" FontWeight="SemiBold" />
                        <TextBlock x:Name="TrafficText" Style="{StaticResource Secondary}" Margin="{DynamicResource SpacingBlockStart}" />
                        <TextBlock x:Name="TargetText" Style="{StaticResource Secondary}" Margin="{DynamicResource SpacingValidationGap}" />
                        <TextBlock x:Name="MethodText" Style="{StaticResource Secondary}" Margin="{DynamicResource SpacingValidationGap}" />
                        <Expander Style="{DynamicResource ContentExpanderStyle}" x:Name="MethodExpander" Margin="{DynamicResource SpacingSectionStart}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <TextBlock x:Name="MethodDetail" Style="{StaticResource Secondary}" Margin="{DynamicResource SpacingBlockStart}" />
                        </Expander>
                        <WrapPanel Margin="{DynamicResource SpacingGroupStart}">
                            <TextBlock x:Name="CopyFeedback" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="{DynamicResource SpacingLeadingGroupGap}" AutomationProperties.LiveSetting="Polite" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
