<ContextMenu x:Class="NetGuardian.App.Views.TrayContextMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             MinWidth="232" MaxWidth="320" FontFamily="{DynamicResource AppFontFamily}" FontSize="{DynamicResource FontBody}"
             Background="{DynamicResource SurfaceCardBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
             HasDropShadow="False" StaysOpen="False" UseLayoutRounding="True"
             Grid.IsSharedSizeScope="True" SnapsToDevicePixels="True"
             KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.Name="NetGuardian">
    <ContextMenu.Template>
        <ControlTemplate TargetType="ContextMenu">
            <Border x:Name="MenuSurface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource CornerCard}" Padding="6">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding StatusText, RelativeSource={RelativeSource TemplatedParent}}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{DynamicResource FontCaption}"
                               Margin="10,5,10,7" TextWrapping="Wrap" />
                    <Separator DockPanel.Dock="Top" Margin="4,0,4,4" />
                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </ControlTemplate>
    </ContextMenu.Template>
    <MenuItem x:Name="ShowWindowItem" Tag="ShowWindow">
        <MenuItem.Icon><ui:SymbolIcon Symbol="Home24" FontSize="16" /></MenuItem.Icon>
    </MenuItem>
    <Separator Margin="4,4" />
    <MenuItem x:Name="CheckNowItem" Tag="CheckNow">
        <MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" /></MenuItem.Icon>
    </MenuItem>
    <MenuItem x:Name="StartMonitorItem" Tag="StartMonitor">
        <MenuItem.Icon><ui:SymbolIcon Symbol="Play24" FontSize="16" /></MenuItem.Icon>
    </MenuItem>
    <MenuItem x:Name="StopItem" Tag="Stop">
        <MenuItem.Icon><ui:SymbolIcon Symbol="Stop24" FontSize="16" /></MenuItem.Icon>
    </MenuItem>
    <Separator Margin="4,4" />
    <MenuItem x:Name="ExitItem" Tag="Exit">
        <MenuItem.Icon><ui:SymbolIcon Symbol="Dismiss24" FontSize="16" /></MenuItem.Icon>
    </MenuItem>
</ContextMenu>
