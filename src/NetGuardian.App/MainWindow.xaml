                                <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="{DynamicResource SpacingFieldGap}" AutomationProperties.LabeledBy="{Binding ElementName=UpdateStatusText}" />
                                <WrapPanel>
                                    <Button x:Name="UpdateCheckButton" Style="{StaticResource PrimaryButtonStyle}" Click="UpdateCheck_Click" Margin="{DynamicResource SpacingItemGap}" />
                                    <Button x:Name="UpdateDownloadButton" Style="{StaticResource PrimaryButtonStyle}" Click="UpdateDownload_Click" Visibility="Collapsed" Margin="{DynamicResource SpacingItemGap}" />
                                    <Button x:Name="UpdateCancelButton" Style="{StaticResource SecondaryButtonStyle}" Click="UpdateCancel_Click" Visibility="Collapsed" Margin="{DynamicResource SpacingItemGap}" />
                                    <Button x:Name="UpdateInstallButton" Style="{StaticResource PrimaryButtonStyle}" Click="UpdateInstall_Click" Visibility="Collapsed" Margin="{DynamicResource SpacingItemGap}" />
                                </WrapPanel>
                                <Expander x:Name="UpdateNotesExpander" Style="{DynamicResource ContentExpanderStyle}" Visibility="Collapsed">
                                    <TextBlock x:Name="UpdateNotesText" TextWrapping="Wrap" Margin="{DynamicResource SpacingOptionGap}" />
                                </Expander>
                                <TextBlock x:Name="UpdatePreviousResultText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="{DynamicResource SpacingOptionGap}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </Border>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
