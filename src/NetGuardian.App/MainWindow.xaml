<ui:FluentWindow x:Class="NetGuardian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:NetGuardian.App.Views"
        xmlns:presentation="clr-namespace:NetGuardian.App.Presentation"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="NetGuardian"
        Icon="Assets/app.ico"
        Width="1180"
        Height="760"
        MinWidth="1040"
        MinHeight="660"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource FontBody}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <presentation:TableDetailsConverter x:Key="TableDetailsConverter" />
        <presentation:RowDetailsToggleConverter x:Key="RowDetailsToggleConverter" />
        <sys:String x:Key="TableDetailLabel">详情</sys:String>
        <sys:String x:Key="TableCopyLabel">复制结果</sys:String>
        <presentation:CredentialStatusConverter x:Key="CredentialStatusConverter" />
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource CornerCard}" />
            <Setter Property="Padding" Value="{DynamicResource SpacingCardPadding}" />
        </Style>
        <Style x:Key="StatusHeroCardStyle" TargetType="Border" BasedOn="{StaticResource SectionBorderStyle}">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="StatusMetricCardStyle" TargetType="Border" BasedOn="{StaticResource SectionBorderStyle}">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Height" Value="{DynamicResource GridHeaderHeight}" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="GridCenteredHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="GridTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GridCenteredTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextStyle}">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="All" />
            <Setter Property="CanUserResizeColumns" Value="True" />
            <Setter Property="ClipboardCopyMode" Value="IncludeHeader" />
            <Setter Property="RowDetailsVisibilityMode" Value="Collapsed" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="RowHeaderWidth" Value="28" />
            <Setter Property="ContextMenu">
                <Setter.Value><ContextMenu><MenuItem Header="{DynamicResource TableCopyLabel}" Command="ApplicationCommands.Copy" /></ContextMenu></Setter.Value>
            </Setter>
            <Setter Property="RowHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRowHeader">
                        <Setter Property="Template">
                            <Setter.Value><ControlTemplate TargetType="DataGridRowHeader">
                                <ToggleButton Content="›" FontSize="{DynamicResource FontSubtitle}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" ToolTip="{DynamicResource TableDetailLabel}" AutomationProperties.Name="{DynamicResource TableDetailLabel}" IsChecked="{Binding DetailsVisibility, RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource RowDetailsToggleConverter}, Mode=TwoWay}" />
                            </ControlTemplate></Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowDetailsTemplate">
                <Setter.Value><DataTemplate>
                    <TextBox IsReadOnly="True" TextWrapping="Wrap" MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="8" Padding="12" AutomationProperties.Name="{DynamicResource TableDetailLabel}">
                        <TextBox.Text><MultiBinding Mode="OneWay" Converter="{StaticResource TableDetailsConverter}"><Binding /><Binding RelativeSource="{RelativeSource AncestorType=DataGrid}" /></MultiBinding></TextBox.Text>
                    </TextBox>
                </DataTemplate></Setter.Value>
            </Setter>
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="{DynamicResource GridRowHeight}" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowSelectedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource RowSelectionStrokeBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}" />
            <Setter Property="Padding" Value="{DynamicResource SpacingControlPadding}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource CornerControl}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="FocusRing" Margin="-3" BorderBrush="{DynamicResource FocusRingBrush}" BorderThickness="2" CornerRadius="{DynamicResource CornerControl}" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource StrokeInputBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.8" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource StrokeInputBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="1" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DisabledControlBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource DangerButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource DangerButtonTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBrush}" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource FontSection}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="NetGuardian" Icon="Assets/app-icon-256.png" />

        <ui:SnackbarPresenter x:Name="RootSnackbar" Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="1000"
                              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <presentation:PanelNavigationView x:Name="RootNavigation" AutomationProperties.Name="NetGuardian" PaneDisplayMode="Left" IsPaneOpen="True" CompactPaneLength="56" OpenPaneLength="216" BorderBrush="Transparent" BorderThickness="0" SelectionChanged="RootNavigation_SelectionChanged" IsBackButtonVisible="Collapsed">
                    <presentation:PanelNavigationView.MenuItems>
                        <presentation:PanelNavigationItem x:Name="StatusNavButton" Content="Status" Icon="{ui:SymbolIcon Home24}" Tag="StatusPanel" />
                        <presentation:PanelNavigationItem x:Name="WifiNavButton" Content="Wi-Fi" Icon="{ui:SymbolIcon Wifi124}" Tag="WifiPanel" />
                        <presentation:PanelNavigationItem x:Name="QualityNavButton" Content="Quality" Icon="{ui:SymbolIcon DesktopPulse24}" Tag="QualityPanel" />
                        <presentation:PanelNavigationItem x:Name="ToolsNavButton" Content="Tools" Icon="{ui:SymbolIcon Apps24}" Tag="ToolsPanel" />
                        <presentation:PanelNavigationItem x:Name="DnsNavButton" Content="DNS" Icon="{ui:SymbolIcon Globe24}" Tag="DnsPanel" />
                        <presentation:PanelNavigationItem x:Name="AdapterNavButton" Content="Adapter" Icon="{ui:SymbolIcon DesktopSignal24}" Tag="NetworkPanel" />
                        <presentation:PanelNavigationItem x:Name="PolicyNavButton" Content="Policy" Icon="{ui:SymbolIcon Shield24}" Tag="PolicyPanel" />
                        <presentation:PanelNavigationItem x:Name="LogNavButton" Content="Log" Icon="{ui:SymbolIcon DocumentBulletList24}" Tag="LogPanel" />
                    </presentation:PanelNavigationView.MenuItems>
                    <presentation:PanelNavigationView.FooterMenuItems>
                        <GroupBox x:Name="SidebarTrafficHost" BorderThickness="0" Padding="0" AutomationProperties.Name="{Binding Text, ElementName=SidebarSpeedTitle}">
                            <GroupBox.Template><ControlTemplate TargetType="GroupBox"><ContentPresenter /></ControlTemplate></GroupBox.Template>
                            <Grid>
                                <Border x:Name="SidebarSpeedCard" Width="184" HorizontalAlignment="Center" Margin="0,8,0,12" Background="Transparent" BorderThickness="0" Padding="10,0,10,10" Visibility="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType=presentation:PanelNavigationView}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock x:Name="SidebarSpeedTitle" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SidebarSpeedScopeText" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        <Canvas Width="158" Height="38" Margin="0,10,0,10">
                                            <Polyline x:Name="SidebarDownloadLine" Stroke="{DynamicResource SpeedDownloadBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" />
                                            <Polyline x:Name="SidebarUploadLine" Stroke="{DynamicResource SpeedUploadBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                                        </Canvas>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24" />
                                                <RowDefinition Height="24" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="↑" Foreground="{DynamicResource SpeedUploadBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SidebarUploadSpeedText" Grid.Column="1" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SidebarUploadUnitText" Grid.Column="2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{DynamicResource FontCaption}" VerticalAlignment="Center" TextAlignment="Right" />
                                            <TextBlock Grid.Row="1" Text="↓" Foreground="{DynamicResource SpeedDownloadBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SidebarDownloadSpeedText" Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SidebarDownloadUnitText" Grid.Row="1" Grid.Column="2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{DynamicResource FontCaption}" VerticalAlignment="Center" TextAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="SidebarSpeedCompact" Width="56" HorizontalAlignment="Left" Margin="0,8,0,12" Background="Transparent" BorderThickness="0" Padding="2,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType=presentation:PanelNavigationView}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid Height="21">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="↑" Foreground="{DynamicResource SpeedUploadBrush}" FontSize="{DynamicResource FontCaption}" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SidebarCompactUploadText" Grid.Column="1" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Grid Height="21">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="↓" Foreground="{DynamicResource SpeedDownloadBrush}" FontSize="{DynamicResource FontCaption}" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SidebarCompactDownloadText" Grid.Column="1" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </GroupBox>
                        <presentation:PanelNavigationItem x:Name="SettingsNavButton" Content="Settings" Icon="{ui:SymbolIcon Settings24}" Tag="SettingsPanel" />
                    </presentation:PanelNavigationView.FooterMenuItems>
                </presentation:PanelNavigationView>
            </Grid>

            <Grid Grid.Column="1" Margin="20,10,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="PageTitleText" FontSize="{DynamicResource FontTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="PageSubtitleText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="HeaderStatusPill" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="HeaderStateText" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="CheckNowButton" Style="{StaticResource PrimaryButtonStyle}" Click="CheckNow_Click" />
                    <Button x:Name="StartMonitorButton" Click="StartMonitor_Click" Margin="8,0,0,0" />
                    <Button x:Name="StopButton" Click="StopMonitor_Click" Margin="8,0,0,0" />
                </StackPanel>
            </DockPanel>

            <StackPanel x:Name="PageActionBar" Grid.Row="1" Margin="0,0,0,12" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
                <ScrollViewer x:Name="WifiPageActions" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.Name="Wi-Fi 操作">
                <WrapPanel>
                    <Button x:Name="ScanButton" Click="Scan_Click" Margin="0,0,6,6" />
                    <Button x:Name="WifiScanCancelButton" Click="WifiScanCancel_Click" Visibility="Collapsed" Margin="0,0,6,6" />
                    <Button x:Name="AddSelectedButton" Click="AddSelected_Click" Margin="0,0,6,6" />
                    <Button x:Name="SetPasswordButton" Click="SetPassword_Click" Margin="0,0,6,6" />
                    <Button x:Name="ImportPasswordButton" Click="ImportPassword_Click" Margin="0,0,6,6" />
                    <Button x:Name="AddManualButton" Click="AddManual_Click" Margin="0,0,6,6" />
                    <Button x:Name="MoveUpButton" Click="MoveUp_Click" Margin="0,0,6,6" />
                    <Button x:Name="MoveDownButton" Click="MoveDown_Click" Margin="0,0,6,6" />
                    <Button x:Name="RemoveButton" Style="{StaticResource DangerButtonStyle}" Click="Remove_Click" Margin="0,0,6,6" />
                    <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButtonStyle}" Click="Connect_Click" Margin="0,0,6,6" />
                </WrapPanel>
                </ScrollViewer>
                <WrapPanel x:Name="QualityPageActions" Visibility="Collapsed" AutomationProperties.Name="网络质量操作">
                    <Button x:Name="QualityRunButton" Style="{StaticResource PrimaryButtonStyle}" Click="QualityRun_Click" Margin="0,0,8,8" />
                    <Button x:Name="QualityCancelButton" Click="QualityCancel_Click" Margin="0,0,8,8" Visibility="Collapsed" />
                    <Button x:Name="QualityOpenSettingsButton" Click="ToolsNetworkSettings_Click" Margin="0,0,8,8" />
                </WrapPanel>
                <WrapPanel x:Name="ToolsPageActions" Visibility="Collapsed" AutomationProperties.Name="诊断快捷操作">
                    <Button x:Name="ToolsCheckButton" Click="CheckNow_Click" Margin="0,0,8,8" />
                    <Button x:Name="ToolsScanButton" Click="Scan_Click" Margin="0,0,8,8" />
                    <Button x:Name="ToolsScanCancelButton" Click="WifiScanCancel_Click" Visibility="Collapsed" Margin="0,0,8,8" />
                    <Button x:Name="ToolsNetworkSettingsButton" Click="ToolsNetworkSettings_Click" Margin="0,0,8,8" />
                </WrapPanel>
                <ContentControl x:Name="SpeedPageActions" Visibility="Collapsed" HorizontalContentAlignment="Stretch" />
                <WrapPanel x:Name="WebsitePageActions" Visibility="Collapsed" AutomationProperties.Name="网站探测操作">
                    <Button x:Name="WebsiteRunButton" Style="{StaticResource PrimaryButtonStyle}" Click="WebsiteRun_Click" Margin="0,0,8,8" />
                    <Button x:Name="WebsiteAppleButton" Tag="https://www.apple.com/" Click="WebsitePreset_Click" Margin="0,0,8,8" />
                    <Button x:Name="WebsiteGitHubButton" Tag="https://github.com/" Click="WebsitePreset_Click" Margin="0,0,8,8" />
                    <Button x:Name="WebsiteGoogleButton" Tag="https://www.google.com/" Click="WebsitePreset_Click" Margin="0,0,8,8" />
                    <Button x:Name="WebsiteYouTubeButton" Tag="https://www.youtube.com/" Click="WebsitePreset_Click" Margin="0,0,8,8" />
                    <Button x:Name="WebsiteCancelButton" Click="WebsiteCancel_Click" Visibility="Collapsed" Margin="0,0,8,8" />
                </WrapPanel>
                <WrapPanel x:Name="IpInfoPageActions" Visibility="Collapsed" AutomationProperties.Name="IP 信息操作">
                    <Button x:Name="IpInfoRefreshButton" Click="IpInfoRefresh_Click" Margin="0,0,8,8" />
                    <Button x:Name="IpInfoCancelButton" Click="IpInfoCancel_Click" Visibility="Collapsed" Margin="0,0,8,8" />
                </WrapPanel>
                <WrapPanel x:Name="ReportPageActions" Visibility="Collapsed" AutomationProperties.Name="诊断报告操作">
                    <Button x:Name="ReportRunButton" Style="{StaticResource PrimaryButtonStyle}" Click="ReportRun_Click" Margin="0,0,8,8" />
                    <Button x:Name="ReportCancelButton" Click="ReportCancel_Click" Visibility="Collapsed" Margin="0,0,8,8" />
                </WrapPanel>
                <WrapPanel x:Name="DnsPageActions" Visibility="Collapsed" AutomationProperties.Name="DNS 操作">
                    <Button x:Name="DnsRefreshButton" Click="DnsRefresh_Click" Margin="0,0,8,8" />
                    <Button x:Name="DnsFlushButton" Click="ToolsFlushDns_Click" Margin="0,0,8,8" />
                    <Button x:Name="DnsApplyButton" Style="{StaticResource PrimaryButtonStyle}" Click="DnsApply_Click" Margin="0,0,8,8" />
                </WrapPanel>
                <WrapPanel x:Name="NetworkPageActions" Visibility="Collapsed" AutomationProperties.Name="网络适配器操作">
                    <Button x:Name="AdapterRefreshButton" Click="AdapterRefresh_Click" Margin="0,0,8,8" />
                    <Button x:Name="AdapterSettingsButton" Click="ToolsNetworkSettings_Click" Margin="0,0,8,8" />
                    <Button x:Name="AdapterRenewDhcpButton" Click="ToolsRenewDhcp_Click" Margin="0,0,8,8" />
                </WrapPanel>
                <WrapPanel x:Name="PolicyPageActions" Visibility="Collapsed" AutomationProperties.Name="恢复策略操作">
                    <Button x:Name="SavePolicyButton" Style="{StaticResource PrimaryButtonStyle}" MinWidth="96" Click="SavePolicy_Click" Margin="0,0,8,8" />
                </WrapPanel>
                <WrapPanel x:Name="LogPageActions" Visibility="Collapsed" AutomationProperties.Name="事件日志操作">
                    <Button x:Name="ExportLogsButton" Click="ExportLogs_Click" Margin="0,0,8,8" />
                </WrapPanel>
            </StackPanel>

                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="StatusPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
 <StackPanel>
  <Border Style="{StaticResource StatusHeroCardStyle}" Margin="0,0,0,16">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid Margin="0,0,24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="HealthStateIcon" Text="—" FontSize="{DynamicResource FontDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="{Binding Text, ElementName=HealthStateText}" />
     <StackPanel Grid.Column="1">
