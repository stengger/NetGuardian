<ui:FluentWindow x:Class="NetGuardian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:NetGuardian.App.Views"
        xmlns:presentation="clr-namespace:NetGuardian.App.Presentation"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="NetGuardian"
        Icon="Assets/app.ico"
        Width="1180"
        Height="760"
        MinWidth="1040"
        MinHeight="660"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="{DynamicResource FontBody}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <ui:FluentWindow.Resources>
        <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Common.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="NetGuardian" Icon="Assets/app-icon-256.png" />

        <ScrollViewer Grid.Row="1" Style="{StaticResource FeedbackOverlayHostStyle}">
            <presentation:FeedbackPresenter x:Name="RootSnackbar" HorizontalAlignment="Right"
                                            Width="{DynamicResource FeedbackWidth}" MaxWidth="{DynamicResource FeedbackMaxWidth}"
                                            Margin="{DynamicResource SpacingFeedbackArea}" />
        </ScrollViewer>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <presentation:PanelNavigationView x:Name="RootNavigation" AutomationProperties.Name="NetGuardian" PaneDisplayMode="Left" IsPaneOpen="True" CompactPaneLength="56" OpenPaneLength="216" BorderBrush="Transparent" BorderThickness="0" SelectionChanged="RootNavigation_SelectionChanged" IsBackButtonVisible="Collapsed">
                    <presentation:PanelNavigationView.MenuItems>
                        <presentation:PanelNavigationItem x:Name="StatusNavButton" Content="Status" Icon="{ui:SymbolIcon Home24}" Tag="StatusPanel" />
                        <presentation:PanelNavigationItem x:Name="WifiNavButton" Content="Wi-Fi" Icon="{ui:SymbolIcon Wifi124}" Tag="WifiPanel" />
                        <presentation:PanelNavigationItem x:Name="QualityNavButton" Content="Quality" Icon="{ui:SymbolIcon DesktopPulse24}" Tag="QualityPanel" />
                        <presentation:PanelNavigationItem x:Name="ToolsNavButton" Content="Tools" Icon="{ui:SymbolIcon Apps24}" Tag="ToolsPanel" />
                        <presentation:PanelNavigationItem x:Name="DnsNavButton" Content="DNS" Icon="{ui:SymbolIcon Globe24}" Tag="DnsPanel" />
                        <presentation:PanelNavigationItem x:Name="AdapterNavButton" Content="Adapter" Icon="{ui:SymbolIcon DesktopSignal24}" Tag="NetworkPanel" />
                        <presentation:PanelNavigationItem x:Name="PolicyNavButton" Content="Policy" Icon="{ui:SymbolIcon Shield24}" Tag="PolicyPanel" />
                        <presentation:PanelNavigationItem x:Name="LogNavButton" Content="Log" Icon="{ui:SymbolIcon DocumentBulletList24}" Tag="LogPanel" />
                    </presentation:PanelNavigationView.MenuItems>
                    <presentation:PanelNavigationView.FooterMenuItems>
                        <GroupBox x:Name="SidebarTrafficHost" BorderThickness="0" Padding="0" AutomationProperties.Name="{Binding Text, ElementName=SidebarSpeedTitle}">
                            <GroupBox.Template><ControlTemplate TargetType="GroupBox"><ContentPresenter /></ControlTemplate></GroupBox.Template>
                            <Grid>
                                <Border x:Name="SidebarSpeedCard" Width="184" HorizontalAlignment="Center" Margin="{DynamicResource SpacingEmptyCaption}" Background="Transparent" BorderThickness="0" Padding="{DynamicResource SpacingSideGroup}" Visibility="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType=presentation:PanelNavigationView}, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock x:Name="SidebarSpeedTitle" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="SidebarSpeedScopeText" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="{DynamicResource SpacingValidationGap}" />
                                        <Canvas Width="{DynamicResource TrafficChartWidth}" Height="{DynamicResource TrafficChartHeight}" Margin="{DynamicResource SpacingChartGap}">
                                            <Polyline x:Name="SidebarDownloadLine" Stroke="{DynamicResource SpeedDownloadBrush}" StrokeThickness="1.8" StrokeLineJoin="Round" />
                                            <Polyline x:Name="SidebarUploadLine" Stroke="{DynamicResource SpeedUploadBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" />
                                        </Canvas>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="66" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="24" />
                                                <RowDefinition Height="24" />
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Name="SidebarUploadLegend" Text="↑ 上传" Foreground="{DynamicResource SpeedUploadBrush}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SidebarUploadSpeedText" Grid.Column="1" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SidebarUploadUnitText" Grid.Column="2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{DynamicResource FontCaption}" VerticalAlignment="Center" TextAlignment="Right" />
                                            <TextBlock x:Name="SidebarDownloadLegend" Grid.Row="1" Text="↓ 下载" Foreground="{DynamicResource SpeedDownloadBrush}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SidebarDownloadSpeedText" Grid.Row="1" Grid.Column="1" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SidebarDownloadUnitText" Grid.Row="1" Grid.Column="2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{DynamicResource FontCaption}" VerticalAlignment="Center" TextAlignment="Right" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="SidebarSpeedCompact" Width="56" HorizontalAlignment="Left" Margin="{DynamicResource SpacingEmptyCaption}" Background="Transparent" BorderThickness="0" Padding="{DynamicResource SpacingThinHorizontal}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPaneOpen, RelativeSource={RelativeSource AncestorType=presentation:PanelNavigationView}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid Height="21">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="↑" Foreground="{DynamicResource SpeedUploadBrush}" FontSize="{DynamicResource FontCaption}" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SidebarCompactUploadText" Grid.Column="1" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <Grid Height="21">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="↓" Foreground="{DynamicResource SpeedDownloadBrush}" FontSize="{DynamicResource FontCaption}" FontWeight="Bold" VerticalAlignment="Center" />
                                            <TextBlock x:Name="SidebarCompactDownloadText" Grid.Column="1" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontSize="{DynamicResource FontCaption}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </GroupBox>
                        <presentation:PanelNavigationItem x:Name="SettingsNavButton" Content="Settings" Icon="{ui:SymbolIcon Settings24}" Tag="SettingsPanel" />
                    </presentation:PanelNavigationView.FooterMenuItems>
                </presentation:PanelNavigationView>
            </Grid>

            <Grid Grid.Column="1" Margin="{DynamicResource SpacingPageBody}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Grid.Row="0" Margin="{DynamicResource SpacingBlockGap}" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="PageTitleText" FontSize="{DynamicResource FontTitle}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="PageSubtitleText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="{DynamicResource SpacingValidationGap}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="HeaderStatusPill" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="{DynamicResource StrokeControlThickness}" CornerRadius="{DynamicResource CornerCard}" Padding="{DynamicResource SpacingControlPadding}" Margin="{DynamicResource SpacingInlineGroupGap}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{DynamicResource TextFillColorTertiaryBrush}" Margin="{DynamicResource SpacingInlineGap}" />
                            <TextBlock x:Name="HeaderStateText" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="CheckNowButton" Style="{StaticResource PrimaryButtonStyle}" Click="CheckNow_Click" />
                    <Button x:Name="StartMonitorButton" Click="StartMonitor_Click" Margin="{DynamicResource SpacingLeadingGap}" />
                    <Button x:Name="StopButton" Click="StopMonitor_Click" Margin="{DynamicResource SpacingLeadingGap}" />
                </StackPanel>
            </DockPanel>

            <StackPanel x:Name="PageActionBar" Grid.Row="1" Margin="{DynamicResource SpacingFieldGap}" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite">
                <ScrollViewer x:Name="WifiPageActions" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled" Focusable="False" AutomationProperties.Name="Wi-Fi 操作">
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="{DynamicResource SpacingInlineGap}">
                            <Button x:Name="ScanButton" Click="Scan_Click" Style="{StaticResource WifiToolbarPrimaryButtonStyle}" />
                            <Button x:Name="WifiScanCancelButton" Click="WifiScanCancel_Click" Style="{StaticResource ToolbarButtonStyle}" Visibility="Collapsed" Margin="{DynamicResource SpacingLeadingGap}" />
                            <Button x:Name="ConnectButton" Click="Connect_Click" Style="{StaticResource ToolbarFixedButtonStyle}" Margin="{DynamicResource SpacingLeadingGap}" />
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="{DynamicResource StrokeInlineDivider}" Padding="{DynamicResource SpacingActionDivider}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="AddSelectedButton" Click="AddSelected_Click" Style="{StaticResource ToolbarButtonStyle}" />
                                <Button x:Name="WifiMoreButton" Content="更多" Click="WifiMenu_Click" Style="{StaticResource ToolbarButtonStyle}" Margin="{DynamicResource SpacingLeadingGap}" Tag="{Binding ElementName=WifiMoreSources}">
                                    <Button.ContextMenu><ContextMenu>
                                        <MenuItem Header="{Binding PlacementTarget.Tag.Children[0].Content, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="{Binding PlacementTarget.Tag.Children[0].IsEnabled, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="SetPassword_Click" />
                                        <MenuItem Header="{Binding PlacementTarget.Tag.Children[1].Content, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="{Binding PlacementTarget.Tag.Children[1].IsEnabled, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="ImportPassword_Click" />
                                        <MenuItem Header="{Binding PlacementTarget.Tag.Children[2].Content, RelativeSource={RelativeSource AncestorType=ContextMenu}}" IsEnabled="{Binding PlacementTarget.Tag.Children[2].IsEnabled, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Click="AddManual_Click" />
                                    </ContextMenu></Button.ContextMenu>
                                </Button>
                                <Button x:Name="WifiSelectionInfoButton" Content="ⓘ" Style="{StaticResource ToolbarIconButtonStyle}" Margin="{DynamicResource SpacingLeadingGap}" ToolTip="{Binding Text, ElementName=CurrentWifiSelectionText}" AutomationProperties.Name="{Binding Text, ElementName=CurrentWifiSelectionText}" />
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                                        <Button x:Name="MoveUpButton" Click="MoveUp_Click" Style="{StaticResource ToolbarButtonStyle}" />
                                        <Button x:Name="MoveDownButton" Click="MoveDown_Click" Style="{StaticResource ToolbarButtonStyle}" Margin="{DynamicResource SpacingLeadingGap}" />
                                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="{DynamicResource StrokeInlineDivider}" Padding="{DynamicResource SpacingActionDivider}" Margin="{DynamicResource SpacingLeadingGap}"><Button x:Name="RemoveButton" Click="Remove_Click" Style="{StaticResource WifiToolbarDangerButtonStyle}" /></Border>
                                    </StackPanel>
                        <StackPanel x:Name="WifiMoreSources" Visibility="Collapsed">
                            <Button x:Name="SetPasswordButton" Click="SetPassword_Click" />
                            <Button x:Name="ImportPasswordButton" Click="ImportPassword_Click" />
                            <Button x:Name="AddManualButton" Click="AddManual_Click" />
                        </StackPanel>
                    </WrapPanel>
                </ScrollViewer>
                <WrapPanel x:Name="QualityPageActions" Visibility="Collapsed" AutomationProperties.Name="网络质量操作">
                    <Button x:Name="QualityRunButton" Style="{StaticResource PrimaryButtonStyle}" Click="QualityRun_Click" Margin="{DynamicResource SpacingItemGap}" />
                    <Button x:Name="QualityCancelButton" Click="QualityCancel_Click" Margin="{DynamicResource SpacingItemGap}" Visibility="Collapsed" />
                    <Button x:Name="QualityOpenSettingsButton" Click="ToolsNetworkSettings_Click" Margin="{DynamicResource SpacingItemGap}" />
                </WrapPanel>
                <WrapPanel x:Name="ToolsPageActions" Visibility="Collapsed" AutomationProperties.Name="诊断快捷操作">
                    <Button x:Name="ToolsCheckButton" Style="{StaticResource PrimaryButtonStyle}" Click="CheckNow_Click" Margin="{DynamicResource SpacingItemGap}" />
                    <Button x:Name="ToolsScanButton" Click="Scan_Click" Margin="{DynamicResource SpacingItemGap}" />
                    <Button x:Name="ToolsScanCancelButton" Click="WifiScanCancel_Click" Visibility="Collapsed" Margin="{DynamicResource SpacingItemGap}" />
                    <Button x:Name="ToolsNetworkSettingsButton" Click="ToolsNetworkSettings_Click" Margin="{DynamicResource SpacingItemGap}" />
                </WrapPanel>
                <ContentControl x:Name="SpeedPageActions" Visibility="Collapsed" HorizontalContentAlignment="Stretch" />
                <WrapPanel x:Name="WebsitePageActions" Visibility="Collapsed" AutomationProperties.Name="网站探测操作">
                    <Button x:Name="WebsiteRunButton" Style="{StaticResource PrimaryButtonStyle}" Click="WebsiteRun_Click" Margin="{DynamicResource SpacingItemGap}" />
                    <Button x:Name="WebsiteAppleButton" Tag="https://www.apple.com/" Click="WebsitePreset_Click" Margin="{DynamicResource SpacingItemGap}" />
                    <Button x:Name="WebsiteGitHubButton" Tag="https://github.com/" Click="WebsitePreset_Click" Margin="{DynamicResource SpacingItemGap}" />
                    <Button x:Name="WebsiteGoogleButton" Tag="https://www.google.com/" Click="WebsitePreset_Click" Margin="{DynamicResource SpacingItemGap}" />
                    <Button x:Name="WebsiteYouTubeButton" Tag="https://www.youtube.com/" Click="WebsitePreset_Click" Margin="{DynamicResource SpacingItemGap}" />
                    <Button x:Name="WebsiteCancelButton" Click="WebsiteCancel_Click" Visibility="Collapsed" Margin="{DynamicResource SpacingItemGap}" />
                </WrapPanel>
                <WrapPanel x:Name="IpInfoPageActions" Visibility="Collapsed" AutomationProperties.Name="IP 信息操作">
                    <Button x:Name="IpInfoRefreshButton" Style="{StaticResource PrimaryButtonStyle}" Click="IpInfoRefresh_Click" Margin="{DynamicResource SpacingItemGap}" />
                    <Button x:Name="IpInfoCancelButton" Click="IpInfoCancel_Click" Visibility="Collapsed" Margin="{DynamicResource SpacingItemGap}" />
                </WrapPanel>
                <WrapPanel x:Name="ReportPageActions" Visibility="Collapsed" AutomationProperties.Name="诊断报告操作">
                    <Button x:Name="ReportRunButton" Style="{StaticResource PrimaryButtonStyle}" Click="ReportRun_Click" Margin="{DynamicResource SpacingItemGap}" />
                    <Button x:Name="ReportCancelButton" Click="ReportCancel_Click" Visibility="Collapsed" Margin="{DynamicResource SpacingItemGap}" />
                </WrapPanel>
                <WrapPanel x:Name="DnsPageActions" Visibility="Collapsed" AutomationProperties.Name="DNS 操作">
                    <Button x:Name="DnsRefreshButton" Click="DnsRefresh_Click" Margin="{DynamicResource SpacingItemGap}" />
                    <Button x:Name="DnsFlushButton" Click="ToolsFlushDns_Click" Margin="{DynamicResource SpacingItemGap}" />
                    <Button x:Name="DnsApplyButton" Style="{StaticResource PrimaryButtonStyle}" Click="DnsApply_Click" Margin="{DynamicResource SpacingItemGap}" />
                </WrapPanel>
                <WrapPanel x:Name="NetworkPageActions" Visibility="Collapsed" AutomationProperties.Name="网络适配器操作">
                    <Button x:Name="AdapterRefreshButton" Click="AdapterRefresh_Click" Margin="{DynamicResource SpacingItemGap}" />
                    <Button x:Name="AdapterSettingsButton" Click="ToolsNetworkSettings_Click" Margin="{DynamicResource SpacingItemGap}" />
                    <Button x:Name="AdapterRenewDhcpButton" Click="ToolsRenewDhcp_Click" Margin="{DynamicResource SpacingItemGap}" />
                </WrapPanel>
                <WrapPanel x:Name="PolicyPageActions" Visibility="Collapsed" AutomationProperties.Name="恢复策略操作">
                    <Button x:Name="SavePolicyButton" Style="{StaticResource PrimaryButtonStyle}" MinWidth="96" Click="SavePolicy_Click" Margin="{DynamicResource SpacingItemGap}" />
                </WrapPanel>
                <WrapPanel x:Name="LogPageActions" Visibility="Collapsed" AutomationProperties.Name="事件日志操作">
                    <Button x:Name="ExportLogsButton" Click="ExportLogs_Click" Margin="{DynamicResource SpacingItemGap}" />
                </WrapPanel>
            </StackPanel>

                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="StatusPanel" presentation:ScrollWheelChaining.IsEnabled="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="{DynamicResource SpacingInlineGap}">
 <StackPanel>
  <Border Style="{DynamicResource StatusHeroCardStyle}" Margin="{DynamicResource SpacingGroupGap}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid Margin="{DynamicResource SpacingWideInlineGap}"><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="HealthStateIcon" Text="—" FontSize="{DynamicResource FontDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.Name="{Binding Text, ElementName=HealthStateText}" />
     <StackPanel Grid.Column="1">
      <TextBlock x:Name="HealthStateLabel" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{DynamicResource FontCaption}" />
      <TextBlock x:Name="HealthStateText" FontSize="{DynamicResource FontDisplay}" FontWeight="SemiBold" Margin="{DynamicResource SpacingStatusValue}" TextWrapping="Wrap" />
      <TextBlock x:Name="SummaryText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
      <TextBlock x:Name="ReportContextText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{DynamicResource FontCaption}" Margin="{DynamicResource SpacingBlockStart}" TextWrapping="Wrap" Visibility="Collapsed" />
      <TextBlock x:Name="FirstRunGuideText" Foreground="{DynamicResource StatusInfoBrush}" Margin="{DynamicResource SpacingBlockStart}" TextWrapping="Wrap" Visibility="Collapsed" />
     </StackPanel>
    </Grid>
    <StackPanel Grid.Column="1">
     <TextBlock x:Name="MonitorStateLabel" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{DynamicResource FontCaption}" />
     <TextBlock x:Name="MonitorStateText" FontSize="{DynamicResource FontSection}" FontWeight="SemiBold" Margin="{DynamicResource SpacingStatusValue}" TextWrapping="Wrap" />
     <WrapPanel><TextBlock x:Name="NextCheckLabel" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="{DynamicResource SpacingInlineGap}"/><TextBlock x:Name="NextCheckText" FontWeight="SemiBold"/></WrapPanel>
     <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="{DynamicResource StrokeTopDivider}" Margin="{DynamicResource SpacingSectionStart}" Padding="{DynamicResource SpacingSectionStart}"><StackPanel>
      <TextBlock x:Name="CurrentNetworkLabel" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
      <TextBlock x:Name="CurrentSsidText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="{DynamicResource SpacingStatusValue}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
      <WrapPanel><TextBlock x:Name="FailureStreakLabel" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="{DynamicResource SpacingInlineGap}"/><TextBlock x:Name="FailureStreakText" FontWeight="SemiBold"/></WrapPanel>
     </StackPanel></Border>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Margin="{DynamicResource SpacingGroupGap}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{DynamicResource SectionBorderStyle}" Margin="{DynamicResource SpacingInlineGap}"><StackPanel>
 <TextBlock x:Name="HomeGatewayLabel" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
 <TextBlock x:Name="HomeGatewayValue" Text="—" FontSize="{DynamicResource FontMetric}" FontWeight="SemiBold" Margin="{DynamicResource SpacingMetricValue}" />
 <TextBlock x:Name="HomeGatewaySamples" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
 </StackPanel></Border><Border Grid.Column="1" Style="{DynamicResource SectionBorderStyle}" Margin="{DynamicResource SpacingInlineSides}"><StackPanel>
 <TextBlock x:Name="HomeDnsLabel" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
 <TextBlock x:Name="HomeDnsValue" Text="—" FontSize="{DynamicResource FontMetric}" FontWeight="SemiBold" Margin="{DynamicResource SpacingMetricValue}" />
 <TextBlock x:Name="HomeDnsSamples" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
 </StackPanel></Border><Border Grid.Column="2" Style="{DynamicResource SectionBorderStyle}" Margin="{DynamicResource SpacingLeadingGap}"><StackPanel>
 <TextBlock x:Name="HomeHttpsLabel" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
 <TextBlock x:Name="HomeHttpsValue" Text="—" FontSize="{DynamicResource FontMetric}" FontWeight="SemiBold" Margin="{DynamicResource SpacingMetricValue}" />
 <TextBlock x:Name="HomeHttpsSamples" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
 </StackPanel></Border></Grid>
  <Border Style="{DynamicResource SectionBorderStyle}" Margin="{DynamicResource SpacingGroupGap}">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Margin="{DynamicResource SpacingInlineGroupGap}"><TextBlock x:Name="WeeklyPeriodText" Style="{DynamicResource SectionTitleStyle}"/><TextBlock x:Name="WeeklySummaryText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></StackPanel>
    <StackPanel Grid.Column="1"><TextBlock x:Name="WeeklyOutagesLabel" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock x:Name="WeeklyOutagesText" Text="—" FontSize="{DynamicResource FontMetric}" FontWeight="SemiBold" Margin="{DynamicResource SpacingBlockStart}"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock x:Name="WeeklyRateLabel" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/><TextBlock x:Name="WeeklyRateText" Text="—" FontSize="{DynamicResource FontMetric}" FontWeight="SemiBold" Margin="{DynamicResource SpacingBlockStart}" ToolTip="{Binding Text, ElementName=WeeklySummaryText}"/></StackPanel>
   </Grid>
  </Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{DynamicResource SectionBorderStyle}" Margin="{DynamicResource SpacingInlineGap}"><StackPanel>
    <TextBlock x:Name="ProbeTitleText" Style="{DynamicResource SectionTitleStyle}" /><DataGrid x:Name="ProbeGrid" presentation:ResultTablePresentation.CompactColumns="3" AutomationProperties.Name="{Binding Text, ElementName=ProbeTitleText}" MinHeight="100" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="{DynamicResource GridHeaderHeight}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="ProbeNameColumn" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource GridTextStyle}" />
                                        <DataGridTextColumn x:Name="ProbeOkColumn" Binding="{Binding ResultText}" Width="90" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                        <DataGridTextColumn x:Name="ProbeLatencyColumn" Binding="{Binding LatencyText}" Width="110" ElementStyle="{StaticResource GridTextStyle}" />
                                        <DataGridTextColumn x:Name="ProbeDetailColumn" Binding="{Binding Detail}" Width="3*" ElementStyle="{StaticResource GridTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
   </StackPanel></Border>
   <Border Grid.Column="1" Style="{DynamicResource SectionBorderStyle}" Margin="{DynamicResource SpacingLeadingGap}"><StackPanel>
    <TextBlock x:Name="RecentEventsTitle" Style="{DynamicResource SectionTitleStyle}" />
    <Border Style="{StaticResource EmptyStateStyle}" Visibility="{Binding Visibility, ElementName=RecentEventsEmptyText}"><StackPanel><TextBlock Text="≡" FontSize="{DynamicResource FontMetric}" HorizontalAlignment="Center" Foreground="{DynamicResource StatusInfoBrush}" /><TextBlock x:Name="RecentEventsEmptyText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Visibility="Collapsed" TextAlignment="Center" Margin="{DynamicResource SpacingEmptyCaption}" /><Button x:Name="RecentEventsEmptyAction" Content="{Binding Content, ElementName=CheckNowButton}" IsEnabled="{Binding IsEnabled, ElementName=CheckNowButton}" ToolTip="{Binding ToolTip, ElementName=CheckNowButton}" Click="CheckNow_Click" HorizontalAlignment="Center" /></StackPanel></Border>
    <ListBox x:Name="RecentEventsList" AutomationProperties.Name="{Binding Text, ElementName=RecentEventsTitle}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border BorderBrush="{DynamicResource ChartTrackBrush}" BorderThickness="{DynamicResource StrokeSelectedIndicator}" Margin="{DynamicResource SpacingSmallLeadingGap}"/><Ellipse Width="8" Height="8" Fill="{DynamicResource StatusInfoBrush}" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="{DynamicResource SpacingGaugeCaption}"/>
