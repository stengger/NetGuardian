                        <TextBlock x:Name="AdapterTargetLabel" Margin="0,4,0,4" />
                        <DockPanel>
                            <Button x:Name="AdapterRenewDhcpButton" DockPanel.Dock="Right" Click="ToolsRenewDhcp_Click" Margin="12,0,0,0" />
                            <ComboBox x:Name="AdapterTargetComboBox" AutomationProperties.LabeledBy="{Binding ElementName=AdapterTargetLabel}" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}" />
                        </DockPanel>
                        <TextBlock x:Name="AdapterToolsHint" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.74" />
                        <TextBlock x:Name="AdapterStatusText" Margin="0,14,0,10" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                        <DataGrid x:Name="AdapterGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="AdapterNameColumn" Binding="{Binding Name}" Width="1.8*" MinWidth="180" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="AdapterTypeColumn" Binding="{Binding Type}" Width="110" MinWidth="90" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="AdapterStatusColumn" Binding="{Binding Status}" Width="110" MinWidth="110" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                <DataGridTextColumn x:Name="AdapterIpv4Column" Binding="{Binding Ipv4}" Width="150" MinWidth="140" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="AdapterGatewayColumn" Binding="{Binding Gateway}" Width="150" MinWidth="140" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="AdapterDnsColumn" Binding="{Binding DnsServers}" Width="2*" MinWidth="180" ElementStyle="{StaticResource GridTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="AdapterEmptyText" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Margin="12,54,12,0" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="LogPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="145" /><ColumnDefinition Width="170" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock x:Name="LogSearchLabel" Margin="0,0,0,4" />
                                    <TextBox x:Name="LogSearchTextBox" TextChanged="LogFilter_Changed" AutomationProperties.LabeledBy="{Binding ElementName=LogSearchLabel}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock x:Name="LogLevelLabel" Margin="0,0,0,4" />
                                    <ComboBox x:Name="LogLevelComboBox" SelectedIndex="0" SelectionChanged="LogFilter_Changed" AutomationProperties.LabeledBy="{Binding ElementName=LogLevelLabel}">
                                        <ComboBoxItem Tag="all" /><ComboBoxItem Tag="Information" /><ComboBoxItem Tag="Warning" /><ComboBoxItem Tag="Error" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                    <TextBlock x:Name="LogSourceLabel" Margin="0,0,0,4" />
                                    <ComboBox x:Name="LogSourceComboBox" SelectedIndex="0" SelectionChanged="LogFilter_Changed" AutomationProperties.LabeledBy="{Binding ElementName=LogSourceLabel}">
                                        <ComboBoxItem Tag="all" /><ComboBoxItem Tag="Interface" /><ComboBoxItem Tag="Monitor" /><ComboBoxItem Tag="Diagnostic" /><ComboBoxItem Tag="Network" />
                                    </ComboBox>
                                </StackPanel>
                                <Button x:Name="ExportLogsButton" Grid.Column="3" VerticalAlignment="Bottom" Click="ExportLogs_Click" />
                            </Grid>
                            <TextBlock x:Name="LogScopeText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <DataGrid x:Name="LogGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" PreviewMouseWheel="LogReading_MouseWheel" PreviewKeyDown="LogReading_KeyDown" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="LogTimeColumn" Binding="{Binding TimeText}" Width="160" MinWidth="155" ElementStyle="{StaticResource GridTextStyle}" />
                                    <DataGridTextColumn x:Name="LogLevelColumn" Binding="{Binding LevelText}" Width="80" MinWidth="75" ElementStyle="{StaticResource GridTextStyle}" />
                                    <DataGridTextColumn x:Name="LogSourceColumn" Binding="{Binding SourceText}" Width="140" MinWidth="140" ElementStyle="{StaticResource GridTextStyle}" />
                                    <DataGridTemplateColumn x:Name="LogMessageColumn" Width="*" MinWidth="200">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Summary}" ToolTip="{Binding Message}" Style="{StaticResource GridTextStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="LogEmptyText" Margin="12,54,12,0" VerticalAlignment="Top" TextWrapping="Wrap" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Expander x:Name="LogDetailsExpander" Grid.Row="2" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <TextBox x:Name="LogDetailsTextBox" Text="{Binding SelectedItem.Message, ElementName=LogGrid, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" />
                        </Expander>
                        <DockPanel Grid.Row="3" Margin="0,8,0,0">
                            <CheckBox x:Name="LogFollowCheckBox" DockPanel.Dock="Right" IsChecked="True" Checked="LogFollow_Changed" Unchecked="LogFollow_Changed" />
                            <TextBlock x:Name="LogCountText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>
                    </Grid>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="SettingsPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock x:Name="SettingsTitle" />
                        <Grid Margin="0,12,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="240" HorizontalAlignment="Left" SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem Tag="zh-CN" />
                                <ComboBoxItem Tag="en-US" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ThemeLabel" VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemeComboBox" Grid.Column="1" Width="240" HorizontalAlignment="Left" AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}" SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Tag="auto" />
                                <ComboBoxItem Tag="light" />
                                <ComboBoxItem Tag="dark" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="TrayTitle" Margin="0,8,0,10" />
                        <TextBlock x:Name="CloseBehaviorLabel" />
                        <ComboBox x:Name="CloseBehaviorComboBox" Margin="0,6,0,14" Width="260" HorizontalAlignment="Left" SelectionChanged="CloseBehaviorComboBox_SelectionChanged">
                            <ComboBoxItem Tag="ask" />
                            <ComboBoxItem Tag="exit" />
                            <ComboBoxItem Tag="tray" />
                        </ComboBox>
                        <ui:ToggleSwitch x:Name="StartMonitoringOnLaunchCheckBox" Margin="0,9" Checked="SettingsCheckBox_Changed" Unchecked="SettingsCheckBox_Changed" />
                        <ui:ToggleSwitch x:Name="StartMinimizedToTrayCheckBox" Margin="0,9" Checked="SettingsCheckBox_Changed" Unchecked="SettingsCheckBox_Changed" />
                        <ui:ToggleSwitch x:Name="ScheduledStartupCheckBox" Margin="0,9" Checked="ScheduledStartup_Changed" Unchecked="ScheduledStartup_Changed" />
                        <TextBlock x:Name="ScheduledStartupStatusText" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
