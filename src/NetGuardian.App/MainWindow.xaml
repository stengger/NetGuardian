                                    <DataGrid Grid.Row="2" x:Name="IpInfoGrid" AutomationProperties.Name="{Binding Header, ElementName=IpInfoToolsTab}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="{DynamicResource GridHeaderHeight}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn x:Name="IpInfoNameColumn" Binding="{Binding Name}" Width="180" ElementStyle="{StaticResource GridTextStyle}" />
                                            <DataGridTextColumn x:Name="IpInfoValueColumn" Binding="{Binding Value}" Width="*" ElementStyle="{StaticResource GridTextStyle}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Grid.Row="3" x:Name="IpInfoEmptyText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="ReportToolsTab">
                                <Grid Margin="0,12,0,0">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Grid.Row="1">
                                        <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="ReportStatusText" Margin="0,4,0,10" TextWrapping="Wrap" /></ScrollViewer>
                                        <ProgressBar x:Name="ReportActivity" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8" /></StackPanel>
                                    <DataGrid Grid.Row="2" x:Name="ReportGrid" AutomationProperties.Name="{Binding Header, ElementName=ReportToolsTab}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="{DynamicResource GridHeaderHeight}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn x:Name="ReportItemColumn" Binding="{Binding Item}" Width="180" ElementStyle="{StaticResource GridTextStyle}" />
                                            <DataGridTextColumn x:Name="ReportResultColumn" Binding="{Binding Result}" Width="180" ElementStyle="{StaticResource GridTextStyle}" />
                                            <DataGridTextColumn x:Name="ReportAdviceColumn" Binding="{Binding Advice}" Width="*" ElementStyle="{StaticResource GridTextStyle}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Grid.Row="3" x:Name="ReportEmptyText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />
                                </Grid>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="DnsPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="290" Margin="0,0,0,12">
                        <StackPanel>
                        <TextBlock x:Name="DnsToolsTitle" Visibility="Collapsed" />
                        <StackPanel x:Name="DnsEditor">
                        <TextBlock x:Name="DnsTargetLabel" Margin="0,0,0,4" />
                        <ComboBox x:Name="DnsAdapterComboBox" SelectionChanged="DnsAdapterComboBox_SelectionChanged" AutomationProperties.LabeledBy="{Binding ElementName=DnsTargetLabel}" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}" />
                        <TextBlock x:Name="DnsCurrentText" TextWrapping="Wrap" Margin="0,6,0,12" MaxHeight="48" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,12,0">
                            <TextBlock x:Name="DnsPlanLabel" Margin="0,0,0,4" />
                            <ComboBox x:Name="DnsPresetComboBox" SelectionChanged="DnsPresetComboBox_SelectionChanged" AutomationProperties.LabeledBy="{Binding ElementName=DnsPlanLabel}">
                                <ComboBoxItem Tag="none" />
                                <ComboBoxItem Tag="automatic" />
                                <ComboBoxItem Tag="ali" />
                                <ComboBoxItem Tag="tencent" />
                                <ComboBoxItem Tag="cloudflare" />
                                <ComboBoxItem Tag="google" />
                                <ComboBoxItem Tag="custom" />
                            </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock x:Name="DnsPrimaryLabel" Margin="0,0,0,4" />
                            <TextBox x:Name="DnsPrimaryTextBox" AutomationProperties.LabeledBy="{Binding ElementName=DnsPrimaryLabel}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                            <TextBlock x:Name="DnsSecondaryLabel" Margin="0,0,0,4" />
                            <TextBox x:Name="DnsSecondaryTextBox" AutomationProperties.LabeledBy="{Binding ElementName=DnsSecondaryLabel}" />
                            </StackPanel>
                        </Grid>
                        </StackPanel>
                        <TextBlock x:Name="DnsToolsHint" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        </ScrollViewer>
                        <Grid Grid.Row="1">
                        <DataGrid x:Name="DnsGrid" presentation:ResultTablePresentation.CompactColumns="2" AutomationProperties.Name="{Binding Text, ElementName=DnsToolsTitle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="{DynamicResource GridHeaderHeight}">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="DnsAdapterColumn" Binding="{Binding Adapter}" Width="2*" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="DnsServersColumn" Binding="{Binding Servers}" Width="2*" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="DnsSourceColumn" Binding="{Binding Source}" Width="120" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                <DataGridTextColumn x:Name="DnsStatusColumn" Binding="{Binding Status}" Width="120" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="DnsEmptyText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="12,54,12,0" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="True">
                            <TextBlock x:Name="DnsStatusText" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                    </Grid>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="QualityPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="QualityToolsTitle" Visibility="Collapsed" />
                            <ProgressBar x:Name="QualityActivityBar" IsIndeterminate="True" Height="3" Margin="0,0,0,8" Visibility="Collapsed" AutomationProperties.Name="{Binding Text, ElementName=QualityStateText}" />
                        </StackPanel>
                        <ScrollViewer x:Name="QualityBodyScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0" presentation:ScrollWheelChaining.IsEnabled="True">
                        <Grid MinHeight="400" Height="{Binding ViewportHeight, ElementName=QualityBodyScrollViewer}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="QualityScopeText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{DynamicResource FontCaption}" Margin="0,0,0,12" />
                        <StackPanel Grid.Row="1" Margin="0,4,0,12">
                            <TextBlock x:Name="QualityStateText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="QualityPassedText" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,12" TextWrapping="Wrap" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock x:Name="QualityGatewayLabel" TextWrapping="Wrap" />
                                <TextBlock x:Name="QualityGatewayValue" FontSize="{DynamicResource FontMetric}" FontWeight="SemiBold" Margin="0,4,0,4" />
                                <TextBlock x:Name="QualityGatewaySamples" FontSize="{DynamicResource FontCaption}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock x:Name="QualityDnsLabel" TextWrapping="Wrap" />
                                <TextBlock x:Name="QualityDnsValue" FontSize="{DynamicResource FontMetric}" FontWeight="SemiBold" Margin="0,4,0,4" />
                                <TextBlock x:Name="QualityDnsSamples" FontSize="{DynamicResource FontCaption}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock x:Name="QualityHttpsLabel" TextWrapping="Wrap" />
                                <TextBlock x:Name="QualityHttpsValue" FontSize="{DynamicResource FontMetric}" FontWeight="SemiBold" Margin="0,4,0,4" />
                                <TextBlock x:Name="QualityHttpsSamples" FontSize="{DynamicResource FontCaption}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </UniformGrid>
                        </StackPanel>
                        <Grid Grid.Row="2">
                        <DataGrid x:Name="QualityProbeGrid" AutomationProperties.Name="{Binding Text, ElementName=QualityToolsTitle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="{DynamicResource GridHeaderHeight}">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="QualityProbeColumn" Binding="{Binding Name}" Width="2*" MinWidth="180" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="QualityResultColumn" Binding="{Binding ResultText}" Width="90" MinWidth="80" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                <DataGridTextColumn x:Name="QualityLatencyColumn" Binding="{Binding LatencyText}" Width="110" MinWidth="100" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="QualityDetailColumn" Binding="{Binding Detail}" Width="3*" MinWidth="180" ElementStyle="{StaticResource GridTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="QualityEmptyText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="12,54,12,0" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                        <ScrollViewer Grid.Row="3" Margin="0,12,0,0" MaxHeight="64" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBlock x:Name="QualityStatusText" TextWrapping="Wrap" />
                        </ScrollViewer>
                        </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="NetworkPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel>
                        <TextBlock x:Name="AdapterToolsTitle" Visibility="Collapsed" />
                        <TextBlock x:Name="AdapterTargetLabel" Margin="0,4,0,4" />
                        <DockPanel>
                            <ComboBox x:Name="AdapterTargetComboBox" AutomationProperties.LabeledBy="{Binding ElementName=AdapterTargetLabel}" ToolTip="{Binding SelectedItem.Name, RelativeSource={RelativeSource Self}}" />
                        </DockPanel>
                        <TextBlock x:Name="AdapterToolsHint" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="AdapterStatusText" Margin="0,14,0,10" TextWrapping="Wrap" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                        <DataGrid x:Name="AdapterGrid" presentation:ResultTablePresentation.CompactColumns="1,4,5" AutomationProperties.Name="{Binding Text, ElementName=AdapterToolsTitle}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="{DynamicResource GridHeaderHeight}">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="AdapterNameColumn" Binding="{Binding Name}" Width="1.8*" MinWidth="180" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="AdapterTypeColumn" Binding="{Binding Type}" Width="110" MinWidth="90" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="AdapterStatusColumn" Binding="{Binding Status}" Width="110" MinWidth="110" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                <DataGridTextColumn x:Name="AdapterIpv4Column" Binding="{Binding Ipv4}" Width="150" MinWidth="140" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="AdapterGatewayColumn" Binding="{Binding Gateway}" Width="150" MinWidth="140" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="AdapterDnsColumn" Binding="{Binding DnsServers}" Width="2*" MinWidth="180" ElementStyle="{StaticResource GridTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock x:Name="AdapterEmptyText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="12,54,12,0" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="LogPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <StackPanel Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="145" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock x:Name="LogSearchLabel" Margin="0,0,0,4" />
                                    <TextBox x:Name="LogSearchTextBox" TextChanged="LogFilter_Changed" AutomationProperties.LabeledBy="{Binding ElementName=LogSearchLabel}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                    <TextBlock x:Name="LogLevelLabel" Margin="0,0,0,4" />
                                    <ComboBox x:Name="LogLevelComboBox" SelectedIndex="0" SelectionChanged="LogFilter_Changed" AutomationProperties.LabeledBy="{Binding ElementName=LogLevelLabel}">
                                        <ComboBoxItem Tag="all" /><ComboBoxItem Tag="Information" /><ComboBoxItem Tag="Warning" /><ComboBoxItem Tag="Error" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                    <TextBlock x:Name="LogSourceLabel" Margin="0,0,0,4" />
                                    <ComboBox x:Name="LogSourceComboBox" SelectedIndex="0" SelectionChanged="LogFilter_Changed" AutomationProperties.LabeledBy="{Binding ElementName=LogSourceLabel}">
                                        <ComboBoxItem Tag="all" /><ComboBoxItem Tag="Interface" /><ComboBoxItem Tag="Monitor" /><ComboBoxItem Tag="Diagnostic" /><ComboBoxItem Tag="Network" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <TextBlock x:Name="LogScopeText" TextWrapping="Wrap" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                        <ScrollViewer x:Name="LogBodyScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0" presentation:ScrollWheelChaining.IsEnabled="True">
                        <Grid MinHeight="400" Height="{Binding ViewportHeight, ElementName=LogBodyScrollViewer}">
                        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <DataGrid x:Name="LogGrid" AutomationProperties.Name="{Binding Content, ElementName=LogNavButton}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" PreviewKeyDown="LogReading_KeyDown" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn x:Name="LogTimeColumn" Binding="{Binding TimeText}" Width="160" MinWidth="155" ElementStyle="{StaticResource GridTextStyle}" />
                                    <DataGridTextColumn x:Name="LogLevelColumn" Binding="{Binding LevelText}" Width="80" MinWidth="75" ElementStyle="{StaticResource GridTextStyle}" />
                                    <DataGridTextColumn x:Name="LogSourceColumn" Binding="{Binding SourceText}" Width="140" MinWidth="140" ElementStyle="{StaticResource GridTextStyle}" />
                                    <DataGridTemplateColumn x:Name="LogMessageColumn" ClipboardContentBinding="{Binding Message}" Width="*" MinWidth="200">
                                        <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Summary}" ToolTip="{Binding Message}" Style="{StaticResource GridTextStyle}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="LogEmptyText" Margin="12,54,12,0" VerticalAlignment="Top" TextWrapping="Wrap" IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <Expander x:Name="LogDetailsExpander" Grid.Row="1" Margin="0,8,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <TextBox x:Name="LogDetailsTextBox" AutomationProperties.Name="{Binding Header, ElementName=LogDetailsExpander}" Text="{Binding SelectedItem.Message, ElementName=LogGrid, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" />
                        </Expander>
                        <DockPanel Grid.Row="2" Margin="0,8,0,0">
                            <CheckBox x:Name="LogFollowCheckBox" DockPanel.Dock="Right" IsChecked="True" Checked="LogFollow_Changed" Unchecked="LogFollow_Changed" />
                            <TextBlock x:Name="LogCountText" VerticalAlignment="Center" FontSize="{DynamicResource FontCaption}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </DockPanel>
                        </Grid>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="SettingsPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,8">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock x:Name="SettingsTitle" Visibility="Collapsed" />
                        <Grid Margin="0,12,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="240" HorizontalAlignment="Left" AutomationProperties.LabeledBy="{Binding ElementName=LanguageLabel}" SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem Tag="zh-CN" />
                                <ComboBoxItem Tag="en-US" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="ThemeLabel" VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemeComboBox" Grid.Column="1" Width="240" HorizontalAlignment="Left" AutomationProperties.LabeledBy="{Binding ElementName=ThemeLabel}" SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Tag="auto" />
                                <ComboBoxItem Tag="light" />
                                <ComboBoxItem Tag="dark" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="TrayTitle" Margin="0,8,0,10" />
                        <TextBlock x:Name="CloseBehaviorLabel" />
                        <ComboBox x:Name="CloseBehaviorComboBox" Margin="0,6,0,14" Width="260" HorizontalAlignment="Left" AutomationProperties.LabeledBy="{Binding ElementName=CloseBehaviorLabel}" SelectionChanged="CloseBehaviorComboBox_SelectionChanged">
                            <ComboBoxItem Tag="ask" />
                            <ComboBoxItem Tag="exit" />
                            <ComboBoxItem Tag="tray" />
                        </ComboBox>
                        <ui:ToggleSwitch x:Name="StartMonitoringOnLaunchCheckBox" Margin="0,9" Checked="SettingsCheckBox_Changed" Unchecked="SettingsCheckBox_Changed" />
                        <ui:ToggleSwitch x:Name="StartMinimizedToTrayCheckBox" Margin="0,9" Checked="SettingsCheckBox_Changed" Unchecked="SettingsCheckBox_Changed" />
                        <ui:ToggleSwitch x:Name="ScheduledStartupCheckBox" Margin="0,9" Checked="ScheduledStartup_Changed" Unchecked="ScheduledStartup_Changed" />
                        <TextBlock x:Name="ScheduledStartupStatusText" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="{DynamicResource FontCaption}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
