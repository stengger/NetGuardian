                                        <ComboBoxItem Tag="all" /><ComboBoxItem Tag="Information" /><ComboBoxItem Tag="Warning" /><ComboBoxItem Tag="Error" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="{DynamicResource SpacingTrailingGroupGap}">
                                    <TextBlock x:Name="LogSourceLabel" Margin="{DynamicResource SpacingFieldCaptionGap}" />
