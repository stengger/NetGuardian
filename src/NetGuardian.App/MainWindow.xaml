                                <ComboBoxItem Tag="3600" />
                            </ComboBox>
                        </Grid>
                        <ui:ToggleSwitch x:Name="AutoSwitchCheckBox" Margin="0,9" />
                        <ui:ToggleSwitch x:Name="SoftReconnectCheckBox" Margin="0,9" />
                        <ui:ToggleSwitch x:Name="WifiAutoEnableCheckBox" Margin="0,9" />
                        <ui:ToggleSwitch x:Name="DnsFlushCheckBox" Margin="0,9" />
                        <Button x:Name="SavePolicyButton" HorizontalAlignment="Left" Margin="0,18,0,0" Click="SavePolicy_Click" />
                        <TextBlock x:Name="PolicyStatusText" Margin="0,12,0,0" TextWrapping="Wrap" Opacity="0.78" />
                    </StackPanel>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="ToolsPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="ToolsTitle" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <TabControl x:Name="ToolsTabControl">
                            <TabItem x:Name="QuickToolsTab">
                                <StackPanel Margin="0,12,0,0">
                                    <WrapPanel>
                                        <Button x:Name="ToolsCheckButton" Click="CheckNow_Click" Margin="0,0,8,8" />
                                        <Button x:Name="ToolsScanButton" Click="Scan_Click" Margin="0,0,8,8" />
                                        <Button x:Name="ToolsNetworkSettingsButton" Click="ToolsNetworkSettings_Click" Margin="0,0,8,8" />
                                    </WrapPanel>
                                    <TextBlock x:Name="HighRiskText" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.74" />
                                    <TextBlock x:Name="ToolsOutputText" Margin="0,14,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </TabItem>
                            <TabItem x:Name="SpeedToolsTab">
                                <Grid Margin="0,14,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.25*" />
                                        <ColumnDefinition Width="0.95*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.RowSpan="2" Background="#0E141B" BorderBrush="#253349" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,14,0">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DockPanel Margin="0,0,0,10" LastChildFill="False">
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock x:Name="SpeedGaugePhaseText" Foreground="#DDE6F2" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="SpeedStatusText" Foreground="#8FA0B5" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                </StackPanel>
                                                <Button x:Name="SpeedRunButton" DockPanel.Dock="Right" Click="SpeedRun_Click" MinWidth="96" />
                                            </DockPanel>
                                            <Canvas Grid.Row="1" Width="420" Height="270" HorizontalAlignment="Center" Margin="0,2,0,0">
                                                <Path Stroke="#223149" StrokeThickness="30" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 83,210 A 135,135 0 0 1 337,210" />
                                                <Path Stroke="#182231" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 83,210 A 135,135 0 0 1 337,210" />
                                                <Path x:Name="SpeedGaugeArc" Stroke="#55E6D5" StrokeThickness="30" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <Line x:Name="SpeedGaugeNeedle" X1="210" Y1="210" X2="210" Y2="86" Stroke="#F5F0E6" StrokeThickness="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <Ellipse Width="22" Height="22" Fill="#F5F0E6" Canvas.Left="199" Canvas.Top="199" />
                                                <Ellipse Width="8" Height="8" Fill="#0E141B" Canvas.Left="206" Canvas.Top="206" />
                                                <TextBlock Text="0" Canvas.Left="88" Canvas.Top="206" Foreground="#D9E2EF" FontWeight="SemiBold" Opacity="0.74" />
                                                <TextBlock Text="10" Canvas.Left="112" Canvas.Top="143" Foreground="#D9E2EF" FontWeight="SemiBold" Opacity="0.74" />
                                                <TextBlock Text="50" Canvas.Left="154" Canvas.Top="100" Foreground="#D9E2EF" FontWeight="SemiBold" Opacity="0.74" />
                                                <TextBlock Text="100" Canvas.Left="195" Canvas.Top="80" Foreground="#D9E2EF" FontWeight="SemiBold" Opacity="0.74" />
                                                <TextBlock Text="250" Canvas.Left="254" Canvas.Top="100" Foreground="#D9E2EF" FontWeight="SemiBold" Opacity="0.74" />
                                                <TextBlock Text="500" Canvas.Left="291" Canvas.Top="143" Foreground="#D9E2EF" FontWeight="SemiBold" Opacity="0.74" />
                                                <TextBlock Text="1000" Canvas.Left="300" Canvas.Top="206" Foreground="#D9E2EF" FontWeight="SemiBold" Opacity="0.74" />
                                                <TextBlock x:Name="SpeedGaugeValueText" Width="160" Canvas.Left="130" Canvas.Top="168" FontSize="36" FontWeight="Light" Foreground="#F7FAFF" TextAlignment="Center" />
                                                <TextBlock Text="Mbps" Width="160" Canvas.Left="130" Canvas.Top="211" Foreground="#91A2B8" FontSize="12" TextAlignment="Center" />
                                            </Canvas>
                                            <Border Grid.Row="2" Height="1" Background="#26364A" Opacity="0.7" Margin="34,0" />
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#111820" BorderBrush="#2C3B50" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock x:Name="DownloadSpeedLabel" Foreground="#9FB0C4" FontSize="12" />
                                                <TextBlock x:Name="DownloadSpeedText" FontSize="28" FontWeight="SemiBold" Foreground="#F4F8FF" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                                <Border Height="3" Background="#6EA8FF" CornerRadius="2" Margin="0,14,34,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="1" Background="#111820" BorderBrush="#2C3B50" BorderThickness="1" CornerRadius="8" Padding="14" Margin="8,0,0,0">
                                            <StackPanel>
                                                <TextBlock x:Name="UploadSpeedLabel" Foreground="#9FB0C4" FontSize="12" />
                                                <TextBlock x:Name="UploadSpeedText" FontSize="28" FontWeight="SemiBold" Foreground="#F4F8FF" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                                                <Border Height="3" Background="#F59E0B" CornerRadius="2" Margin="0,14,34,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Grid.Row="1" Grid.Column="1" Background="#111820" BorderBrush="#2C3B50" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,14,0,0">
                                        <StackPanel>
                                            <TextBlock x:Name="SpeedLatencyLabel" Foreground="#9FB0C4" FontSize="12" />
                                            <TextBlock x:Name="SpeedLatencyText" FontSize="30" FontWeight="SemiBold" Foreground="#F4F8FF" Margin="0,8,0,0" />
                                            <Border Height="3" Background="#55E6D5" CornerRadius="2" Margin="0,14,64,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </TabItem>
                            <TabItem x:Name="WebsiteToolsTab">
                                <StackPanel Margin="0,12,0,0">
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="WebsiteUrlTextBox" Margin="0,0,8,0" />
                                        <Button x:Name="WebsiteRunButton" Grid.Column="1" Click="WebsiteRun_Click" />
                                    </Grid>
                                    <WrapPanel Margin="0,0,0,12">
                                        <Button x:Name="WebsiteAppleButton" Tag="https://www.apple.com/" Click="WebsitePreset_Click" Margin="0,0,8,8" />
                                        <Button x:Name="WebsiteGitHubButton" Tag="https://github.com/" Click="WebsitePreset_Click" Margin="0,0,8,8" />
                                        <Button x:Name="WebsiteGoogleButton" Tag="https://www.google.com/" Click="WebsitePreset_Click" Margin="0,0,8,8" />
                                        <Button x:Name="WebsiteYouTubeButton" Tag="https://www.youtube.com/" Click="WebsitePreset_Click" Margin="0,0,8,8" />
                                    </WrapPanel>
                                    <TextBlock x:Name="WebsiteStatusText" Margin="0,0,0,10" TextWrapping="Wrap" />
                                    <DataGrid x:Name="WebsiteGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38" MinHeight="320">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn x:Name="WebsiteNameColumn" Binding="{Binding Name}" Width="130" ElementStyle="{StaticResource GridTextStyle}" />
                                            <DataGridTextColumn x:Name="WebsiteStatusColumn" Binding="{Binding Status}" Width="100" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                            <DataGridTextColumn x:Name="WebsiteHttpColumn" Binding="{Binding HttpStatus}" Width="110" ElementStyle="{StaticResource GridTextStyle}" />
                                            <DataGridTextColumn x:Name="WebsiteDnsColumn" Binding="{Binding DnsLatency}" Width="120" ElementStyle="{StaticResource GridTextStyle}" />
                                            <DataGridTextColumn x:Name="WebsiteLatencyColumn" Binding="{Binding HttpLatency}" Width="120" ElementStyle="{StaticResource GridTextStyle}" />
                                            <DataGridTextColumn x:Name="WebsiteAddressColumn" Binding="{Binding Address}" Width="150" ElementStyle="{StaticResource GridTextStyle}" />
                                            <DataGridTextColumn x:Name="WebsiteDetailColumn" Binding="{Binding Detail}" Width="2*" ElementStyle="{StaticResource GridTextStyle}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </TabItem>
                            <TabItem x:Name="IpInfoToolsTab">
                                <StackPanel Margin="0,12,0,0">
                                    <WrapPanel>
                                        <Button x:Name="IpInfoRefreshButton" Click="IpInfoRefresh_Click" Margin="0,0,8,8" />
                                    </WrapPanel>
                                    <TextBlock x:Name="IpInfoStatusText" Margin="0,4,0,10" TextWrapping="Wrap" />
                                    <DataGrid x:Name="IpInfoGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38" MinHeight="340">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn x:Name="IpInfoNameColumn" Binding="{Binding Name}" Width="180" ElementStyle="{StaticResource GridTextStyle}" />
                                            <DataGridTextColumn x:Name="IpInfoValueColumn" Binding="{Binding Value}" Width="*" ElementStyle="{StaticResource GridTextStyle}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </TabItem>
                            <TabItem x:Name="ReportToolsTab">
                                <StackPanel Margin="0,12,0,0">
                                    <WrapPanel>
                                        <Button x:Name="ReportRunButton" Click="ReportRun_Click" Margin="0,0,8,8" />
                                    </WrapPanel>
                                    <TextBlock x:Name="ReportStatusText" Margin="0,4,0,10" TextWrapping="Wrap" />
                                    <DataGrid x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38" MinHeight="340">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn x:Name="ReportItemColumn" Binding="{Binding Item}" Width="180" ElementStyle="{StaticResource GridTextStyle}" />
                                            <DataGridTextColumn x:Name="ReportResultColumn" Binding="{Binding Result}" Width="180" ElementStyle="{StaticResource GridTextStyle}" />
                                            <DataGridTextColumn x:Name="ReportAdviceColumn" Binding="{Binding Advice}" Width="*" ElementStyle="{StaticResource GridTextStyle}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="DnsPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="DnsToolsTitle" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="DnsRefreshButton" Click="DnsRefresh_Click" Margin="0,0,8,8" />
                            <Button x:Name="DnsFlushButton" Click="ToolsFlushDns_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="DnsAdapterComboBox" Grid.Column="0" Margin="0,0,8,0" SelectionChanged="DnsAdapterComboBox_SelectionChanged" />
                            <ComboBox x:Name="DnsPresetComboBox" Grid.Column="1" Margin="0,0,8,0" SelectionChanged="DnsPresetComboBox_SelectionChanged">
                                <ComboBoxItem Tag="automatic" />
                                <ComboBoxItem Tag="ali" />
                                <ComboBoxItem Tag="tencent" />
                                <ComboBoxItem Tag="cloudflare" />
                                <ComboBoxItem Tag="google" />
                                <ComboBoxItem Tag="custom" />
                            </ComboBox>
                            <TextBox x:Name="DnsPrimaryTextBox" Grid.Column="2" Margin="0,0,8,0" />
                            <TextBox x:Name="DnsSecondaryTextBox" Grid.Column="3" Margin="0,0,8,0" />
                            <Button x:Name="DnsApplyButton" Grid.Column="4" Click="DnsApply_Click" />
                        </Grid>
                        <TextBlock x:Name="DnsToolsHint" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.74" />
                        <TextBlock x:Name="DnsStatusText" Margin="0,14,0,10" TextWrapping="Wrap" />
                        <DataGrid x:Name="DnsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38" MinHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="DnsAdapterColumn" Binding="{Binding Adapter}" Width="2*" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="DnsServersColumn" Binding="{Binding Servers}" Width="2*" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="DnsSourceColumn" Binding="{Binding Source}" Width="120" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                <DataGridTextColumn x:Name="DnsStatusColumn" Binding="{Binding Status}" Width="120" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="QualityPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="QualityToolsTitle" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button x:Name="QualityRunButton" Click="QualityRun_Click" Margin="0,0,8,8" />
                            <Button x:Name="QualityOpenSettingsButton" Click="ToolsNetworkSettings_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                        <Grid Margin="0,8,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="QualityScoreLabel" />
                                <TextBlock x:Name="QualityScoreText" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="QualityLatencyLabel" />
                                <TextBlock x:Name="QualityLatencyText" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="QualityStateLabel" />
                                <TextBlock x:Name="QualityStateText" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="QualityStatusText" Margin="0,0,0,10" TextWrapping="Wrap" />
                        <DataGrid x:Name="QualityProbeGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38" MinHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="QualityProbeColumn" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="QualityResultColumn" Binding="{Binding ResultText}" Width="110" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                <DataGridTextColumn x:Name="QualityLatencyColumn" Binding="{Binding LatencyText}" Width="130" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="QualityDetailColumn" Binding="{Binding Detail}" Width="3*" ElementStyle="{StaticResource GridTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="NetworkPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="AdapterToolsTitle" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button x:Name="AdapterRefreshButton" Click="AdapterRefresh_Click" Margin="0,0,8,8" />
                            <Button x:Name="AdapterRenewDhcpButton" Click="ToolsRenewDhcp_Click" Margin="0,0,8,8" />
                            <Button x:Name="AdapterSettingsButton" Click="ToolsNetworkSettings_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock x:Name="AdapterToolsHint" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.74" />
                        <TextBlock x:Name="AdapterStatusText" Margin="0,14,0,10" TextWrapping="Wrap" />
                        <DataGrid x:Name="AdapterGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38" MinHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="AdapterNameColumn" Binding="{Binding Name}" Width="1.8*" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="AdapterTypeColumn" Binding="{Binding Type}" Width="130" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="AdapterStatusColumn" Binding="{Binding Status}" Width="110" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                <DataGridTextColumn x:Name="AdapterIpv4Column" Binding="{Binding Ipv4}" Width="150" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="AdapterGatewayColumn" Binding="{Binding Gateway}" Width="150" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="AdapterDnsColumn" Binding="{Binding DnsServers}" Width="2*" ElementStyle="{StaticResource GridTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="LogPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <TextBox x:Name="LogTextBox" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="SettingsPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock x:Name="SettingsTitle" />
                        <Grid Margin="0,12,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="240" HorizontalAlignment="Left" SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem Tag="zh-CN" />
                                <ComboBoxItem Tag="en-US" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="TrayTitle" Margin="0,8,0,10" />
                        <TextBlock x:Name="CloseBehaviorLabel" />
                        <ComboBox x:Name="CloseBehaviorComboBox" Margin="0,6,0,14" Width="260" HorizontalAlignment="Left" SelectionChanged="CloseBehaviorComboBox_SelectionChanged">
                            <ComboBoxItem Tag="ask" />
                            <ComboBoxItem Tag="exit" />
                            <ComboBoxItem Tag="tray" />
                        </ComboBox>
                        <ui:ToggleSwitch x:Name="StartMonitoringOnLaunchCheckBox" Margin="0,9" Checked="SettingsCheckBox_Changed" Unchecked="SettingsCheckBox_Changed" />
                        <ui:ToggleSwitch x:Name="StartMinimizedToTrayCheckBox" Margin="0,9" Checked="SettingsCheckBox_Changed" Unchecked="SettingsCheckBox_Changed" />
                    </StackPanel>
                </Border>
            
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
