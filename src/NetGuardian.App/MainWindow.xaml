<ui:FluentWindow x:Class="NetGuardian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="NetGuardian"
        Icon="Assets/app.ico"
        Width="1180"
        Height="760"
        MinWidth="1040"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#11161A" />
            <Setter Property="BorderBrush" Value="#2A3038" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.18" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusHeroCardStyle" TargetType="Border" BasedOn="{StaticResource SectionBorderStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#151B24" Offset="0" />
                        <GradientStop Color="#101418" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#344054" />
        </Style>
        <Style x:Key="StatusMetricCardStyle" TargetType="Border" BasedOn="{StaticResource SectionBorderStyle}">
            <Setter Property="Background" Value="#12171D" />
            <Setter Property="BorderBrush" Value="#2B3440" />
        </Style>
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#111820" />
            <Setter Property="Foreground" Value="#E7EDF5" />
            <Setter Property="BorderBrush" Value="#2A323D" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="GridCenteredHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="GridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0" />
            <Setter Property="Foreground" Value="#CDD6E2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="#EEF4FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GridCenteredTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextStyle}">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="Foreground" Value="#CDD6E2" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#1C2633" Offset="0" />
                                <GradientStop Color="#202A38" Offset="0.52" />
                                <GradientStop Color="#19222E" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#22314A" Offset="0" />
                                <GradientStop Color="#263653" Offset="0.5" />
                                <GradientStop Color="#1F2D44" Offset="1" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="#F4F7FB" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#CDD6E2" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Foreground" Value="#FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Background" Value="#171D25" />
            <Setter Property="BorderBrush" Value="#2B3440" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#F2F5F8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#1D2430" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#364252" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#223047" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#485A70" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.52" />
                                <Setter TargetName="Chrome" Property="Background" Value="#151A20" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="NetGuardian" Icon="Assets/app-icon-256.png" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <ui:NavigationView x:Name="RootNavigation" PaneDisplayMode="Left" IsPaneOpen="True" CompactPaneLength="68" OpenPaneLength="216" BorderBrush="Transparent" BorderThickness="0" SelectionChanged="RootNavigation_SelectionChanged" IsBackButtonVisible="Collapsed">
                    <ui:NavigationView.MenuItems>
                        <ui:NavigationViewItem x:Name="StatusNavButton" Content="Status" Icon="{ui:SymbolIcon Home24}" Tag="StatusPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                        <ui:NavigationViewItem x:Name="WifiNavButton" Content="Wi-Fi" Icon="{ui:SymbolIcon WifiSettings20}" Tag="WifiPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                        <ui:NavigationViewItem x:Name="QualityNavButton" Content="Quality" Icon="{ui:SymbolIcon DesktopPulse24}" Tag="QualityPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                        <ui:NavigationViewItem x:Name="ToolsNavButton" Content="Tools" Icon="{ui:SymbolIcon Apps24}" Tag="ToolsPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                        <ui:NavigationViewItem x:Name="DnsNavButton" Content="DNS" Icon="{ui:SymbolIcon GlobeSearch20}" Tag="DnsPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                        <ui:NavigationViewItem x:Name="AdapterNavButton" Content="Adapter" Icon="{ui:SymbolIcon DesktopSignal24}" Tag="NetworkPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                        <ui:NavigationViewItem x:Name="PolicyNavButton" Content="Policy" Icon="{ui:SymbolIcon DocumentBulletList24}" Tag="PolicyPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                        <ui:NavigationViewItem x:Name="LogNavButton" Content="Log" Icon="{ui:SymbolIcon DocumentBulletList24}" Tag="LogPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                    </ui:NavigationView.MenuItems>
                    <ui:NavigationView.FooterMenuItems>
                        <ui:NavigationViewItem x:Name="SettingsNavButton" Content="Settings" Icon="{ui:SymbolIcon Settings24}" Tag="SettingsPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                    </ui:NavigationView.FooterMenuItems>
                </ui:NavigationView>

                <Border x:Name="SidebarSpeedCard" Width="184" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,64" Background="Transparent" BorderThickness="0" Padding="10,0,10,10" Panel.ZIndex="2" Visibility="{Binding IsPaneOpen, ElementName=RootNavigation, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock x:Name="SidebarSpeedTitle" FontSize="12" FontWeight="SemiBold" Foreground="#D8E0EA" />
                        <Canvas Width="158" Height="38" Margin="0,10,0,10">
                            <Polyline x:Name="SidebarDownloadLine" Stroke="#6EA8FF" StrokeThickness="1.8" StrokeLineJoin="Round" />
                            <Polyline x:Name="SidebarUploadLine" Stroke="#F59E0B" StrokeThickness="1.6" StrokeLineJoin="Round" />
                        </Canvas>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="42" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="↑" Foreground="#F59E0B" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="SidebarUploadSpeedText" Grid.Column="1" Foreground="#F2F5F8" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="SidebarUploadUnitText" Grid.Column="2" Foreground="#B9C3D0" FontSize="11" VerticalAlignment="Center" TextAlignment="Right" />
                            <TextBlock Grid.Row="1" Text="↓" Foreground="#6EA8FF" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="SidebarDownloadSpeedText" Grid.Row="1" Grid.Column="1" Foreground="#F2F5F8" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="SidebarDownloadUnitText" Grid.Row="1" Grid.Column="2" Foreground="#B9C3D0" FontSize="11" VerticalAlignment="Center" TextAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border x:Name="SidebarSpeedCompact" Width="68" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,72" Background="Transparent" BorderThickness="0" Padding="5,0" Panel.ZIndex="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPaneOpen, ElementName=RootNavigation}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Grid Height="21">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="↑" Foreground="#F59E0B" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock x:Name="SidebarCompactUploadSpeedText" Grid.Column="1" Foreground="#F2F5F8" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SidebarCompactUploadUnitText" Grid.Column="2" Foreground="#AEB8C5" FontSize="8.2" VerticalAlignment="Center" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <Grid Height="21">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="24" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="↓" Foreground="#6EA8FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock x:Name="SidebarCompactDownloadSpeedText" Grid.Column="1" Foreground="#F2F5F8" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="SidebarCompactDownloadUnitText" Grid.Column="2" Foreground="#AEB8C5" FontSize="8.2" VerticalAlignment="Center" TextAlignment="Left" TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Column="1" Margin="20,10,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Grid.Row="0" Margin="0,0,0,18" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="PageTitleText" FontSize="18" FontWeight="SemiBold" Foreground="#F2F5F8" />
                    <TextBlock x:Name="PageSubtitleText" Foreground="#9AA7B8" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="HeaderStatusPill" Background="#171D25" BorderBrush="#303946" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Red" Margin="0,0,8,0" />
                            <TextBlock x:Name="HeaderStateText" Foreground="#F2F5F8" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="CheckNowButton" Click="CheckNow_Click" />
                    <Button x:Name="StartMonitorButton" Click="StartMonitor_Click" />
                    <Button x:Name="StopButton" Click="StopMonitor_Click" />
                </StackPanel>
            </DockPanel>

            

                <Grid Grid.Row="1">
                    <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="StatusPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,12,12" Style="{StaticResource StatusHeroCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="HealthStateLabel" Foreground="#AEB8C5" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="HealthStateText" FontSize="34" FontWeight="SemiBold" Foreground="#6EA8FF" Margin="0,8,0,10" />
                            <TextBlock x:Name="SummaryText" Foreground="#D5DCE6" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="6,0,6,12" Style="{StaticResource StatusMetricCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="MonitorStateLabel" Foreground="#AEB8C5" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="MonitorStateText" FontSize="24" FontWeight="SemiBold" Foreground="#F2F5F8" Margin="0,8,0,14" />
                            <TextBlock x:Name="NextCheckLabel" Foreground="#AEB8C5" FontSize="12" />
                            <TextBlock x:Name="NextCheckText" FontSize="16" FontWeight="SemiBold" Foreground="#DDE5EF" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Margin="12,0,0,12" Style="{StaticResource StatusMetricCardStyle}">
                        <StackPanel>
                            <TextBlock x:Name="CurrentNetworkLabel" Foreground="#AEB8C5" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock x:Name="CurrentSsidText" FontSize="20" FontWeight="SemiBold" Foreground="#F2F5F8" Margin="0,8,0,14" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FailureStreakLabel" Foreground="#AEB8C5" FontSize="12" />
                            <TextBlock x:Name="FailureStreakText" FontSize="20" FontWeight="SemiBold" Foreground="#DDE5EF" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Margin="0,0,12,0" Style="{StaticResource SectionBorderStyle}">
                            <DockPanel>
                                <TextBlock x:Name="ProbeTitleText" DockPanel.Dock="Top" FontWeight="SemiBold" Foreground="#F2F5F8" Margin="0,0,0,12" />
                                <DataGrid x:Name="ProbeGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="ProbeNameColumn" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource GridTextStyle}" />
                                        <DataGridTextColumn x:Name="ProbeOkColumn" Binding="{Binding ResultText}" Width="90" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                        <DataGridTextColumn x:Name="ProbeLatencyColumn" Binding="{Binding LatencyText}" Width="110" ElementStyle="{StaticResource GridTextStyle}" />
                                        <DataGridTextColumn x:Name="ProbeDetailColumn" Binding="{Binding Detail}" Width="3*" ElementStyle="{StaticResource GridTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource SectionBorderStyle}">
                            <DockPanel>
                                <TextBlock x:Name="RecentEventsTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Foreground="#F2F5F8" Margin="0,0,0,12" />
                                <ListBox x:Name="RecentEventsList" BorderThickness="0" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="WifiPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8">
                        <Button x:Name="ScanButton" Click="Scan_Click" Margin="0,0,6,6" />
                        <Button x:Name="AddSelectedButton" Click="AddSelected_Click" Margin="0,0,6,6" />
                        <Button x:Name="SetPasswordButton" Click="SetPassword_Click" Margin="0,0,6,6" />
                        <Button x:Name="ImportPasswordButton" Click="ImportPassword_Click" Margin="0,0,6,6" />
                        <Button x:Name="AddManualButton" Click="AddManual_Click" Margin="0,0,6,6" />
                        <Button x:Name="MoveUpButton" Click="MoveUp_Click" Margin="0,0,6,6" />
                        <Button x:Name="MoveDownButton" Click="MoveDown_Click" Margin="0,0,6,6" />
                        <Button x:Name="RemoveButton" Click="Remove_Click" Margin="0,0,6,6" />
                        <Button x:Name="ConnectButton" Click="Connect_Click" Margin="0,0,6,6" />
                    </WrapPanel>
                    <Border x:Name="WifiSelectionBar" Grid.Row="1" Background="#171D25" BorderBrush="#303946" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8">
                        <TextBlock x:Name="CurrentWifiSelectionText" Foreground="#DDE5EF" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock x:Name="DragHintText" Grid.Row="2" Margin="0,0,0,12" Opacity="0.72" TextWrapping="Wrap" />
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1.25*" />
                        </Grid.ColumnDefinitions>
                        <Border Margin="0,0,10,0" Style="{StaticResource SectionBorderStyle}">
                            <DockPanel>
                                <TextBlock x:Name="NearbyNetworksTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <DataGrid x:Name="NearbyGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38" SelectionChanged="NearbyGrid_SelectionChanged" MouseDoubleClick="NearbyGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="NearbySsidColumn" Binding="{Binding Ssid}" Width="*" ElementStyle="{StaticResource GridTextStyle}" />
                                        <DataGridTextColumn x:Name="NearbySignalColumn" Binding="{Binding SignalPercent}" Width="82" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                        <DataGridTextColumn x:Name="NearbySecurityColumn" Binding="{Binding Authentication}" Width="140" ElementStyle="{StaticResource GridTextStyle}" />
                                        <DataGridTemplateColumn x:Name="NearbyPriorityColumn" Width="108" HeaderStyle="{StaticResource GridCenteredHeaderStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8,3" CornerRadius="10" HorizontalAlignment="Center" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="#1B222B" />
                                                                <Setter Property="BorderBrush" Value="#303946" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsInPriorityList}" Value="True">
                                                                        <Setter Property="Background" Value="#202B42" />
                                                                        <Setter Property="BorderBrush" Value="#6EA8FF" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding PriorityBadge}" FontSize="12" FontWeight="SemiBold" Foreground="#DDE5EF" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource SectionBorderStyle}">
                            <DockPanel>
                                <TextBlock x:Name="PriorityListTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <DataGrid x:Name="ProfileGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38" SelectionChanged="ProfileGrid_SelectionChanged" MouseDoubleClick="ProfileGrid_MouseDoubleClick" AllowDrop="True" PreviewMouseLeftButtonDown="ProfileGrid_PreviewMouseLeftButtonDown" MouseMove="ProfileGrid_MouseMove" Drop="ProfileGrid_Drop">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="ProfileDragColumn" Binding="{Binding DragHandle}" Width="42" IsReadOnly="True" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                        <DataGridTextColumn x:Name="ProfileSsidColumn" Binding="{Binding Ssid}" IsReadOnly="True" Width="*" ElementStyle="{StaticResource GridTextStyle}" />
                                        <DataGridTextColumn x:Name="ProfilePriorityColumn" Binding="{Binding Priority}" IsReadOnly="True" Width="74" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                        <DataGridTemplateColumn x:Name="ProfileCredentialColumn" IsReadOnly="True" Width="88" HeaderStyle="{StaticResource GridCenteredHeaderStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:ToggleSwitch IsChecked="{Binding CredentialSaved}" IsEnabled="False" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn x:Name="ProfileEnabledColumn" Width="78" HeaderStyle="{StaticResource GridCenteredHeaderStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:ToggleSwitch IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Checked="ProfileEnabledToggle_Changed" Unchecked="ProfileEnabledToggle_Changed" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn x:Name="ProfileFailuresColumn" Binding="{Binding FailureCount}" IsReadOnly="True" Width="88" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="PolicyPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
