<ui:FluentWindow x:Class="NetGuardian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="NetGuardian"
        Icon="Assets/app.ico"
        Width="1180"
        Height="760"
        MinWidth="1040"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="NetGuardian" Icon="Assets/app-icon-256.png" />

        <Grid Grid.Row="1">
            <ui:NavigationView x:Name="RootNavigation" PaneDisplayMode="Left" SelectionChanged="RootNavigation_SelectionChanged" IsBackButtonVisible="Collapsed">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem x:Name="StatusNavButton" Content="Status" Icon="{ui:SymbolIcon Home24}" Tag="StatusPanel" />
                    <ui:NavigationViewItem x:Name="WifiNavButton" Content="Wi-Fi" Icon="{ui:SymbolIcon Wifi424}" Tag="WifiPanel" />
                    <ui:NavigationViewItem x:Name="PolicyNavButton" Content="Policy" Icon="{ui:SymbolIcon Document24}" Tag="PolicyPanel" />
                    <ui:NavigationViewItem x:Name="ToolsNavButton" Content="Tools" Icon="{ui:SymbolIcon Wrench24}" Tag="ToolsPanel" />
                    <ui:NavigationViewItem x:Name="LogNavButton" Content="Log" Icon="{ui:SymbolIcon Document24}" Tag="LogPanel" />
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem x:Name="SettingsNavButton" Content="Settings" Icon="{ui:SymbolIcon Settings24}" Tag="SettingsPanel" />
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <Grid Margin="50,40,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Grid.Row="0" Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="PageTitleText" />
                    <TextBlock x:Name="PageSubtitleText" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="HeaderStatusPill" Background="#272C25" BorderBrush="#3A4037" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Red" Margin="0,0,8,0" />
                            <TextBlock x:Name="HeaderStateText" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="CheckNowButton" Click="CheckNow_Click" />
                    <Button x:Name="StartMonitorButton" Click="StartMonitor_Click" />
                    <Button x:Name="StopButton" Click="StopMonitor_Click" />
                </StackPanel>
            </DockPanel>

            

                <Grid Grid.Row="1">
                    <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="StatusPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock x:Name="HealthStateLabel" />
                            <TextBlock x:Name="HealthStateText" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,4,0,8" />
                            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="6,0,6,12">
                        <StackPanel>
                            <TextBlock x:Name="MonitorStateLabel" />
                            <TextBlock x:Name="MonitorStateText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,12" />
                            <TextBlock x:Name="NextCheckLabel" />
                            <TextBlock x:Name="NextCheckText" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Margin="12,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="CurrentNetworkLabel" />
                            <TextBlock x:Name="CurrentSsidText" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,12" />
                            <TextBlock x:Name="FailureStreakLabel" />
                            <TextBlock x:Name="FailureStreakText" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Margin="0,0,12,0">
                            <DockPanel>
                                <TextBlock x:Name="ProbeTitleText" DockPanel.Dock="Top" />
                                <DataGrid x:Name="ProbeGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="ProbeNameColumn" Binding="{Binding Name}" Width="2*" />
                                        <DataGridTextColumn x:Name="ProbeOkColumn" Binding="{Binding Ok}" Width="80" />
                                        <DataGridTextColumn x:Name="ProbeLatencyColumn" Binding="{Binding LatencyText}" Width="110" />
                                        <DataGridTextColumn x:Name="ProbeDetailColumn" Binding="{Binding Detail}" Width="3*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="12,0,0,0">
                            <DockPanel>
                                <TextBlock x:Name="RecentEventsTitle" DockPanel.Dock="Top" />
                                <ListBox x:Name="RecentEventsList" BorderThickness="0" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="WifiPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="DragHintText" DockPanel.Dock="Right" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ScanButton" Click="Scan_Click" />
                            <Button x:Name="AddSelectedButton" Click="AddSelected_Click" />
                            <Button x:Name="SetPasswordButton" Click="SetPassword_Click" />
                            <Button x:Name="AddManualButton" Click="AddManual_Click" />
                            <Button x:Name="MoveUpButton" Click="MoveUp_Click" />
                            <Button x:Name="MoveDownButton" Click="MoveDown_Click" />
                            <Button x:Name="RemoveButton" Click="Remove_Click" />
                            <Button x:Name="ConnectButton" Click="Connect_Click" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1.25*" />
                        </Grid.ColumnDefinitions>
                        <Border Margin="0,0,10,0">
                            <DockPanel>
                                <TextBlock x:Name="NearbyNetworksTitle" DockPanel.Dock="Top" />
                                <DataGrid x:Name="NearbyGrid" MouseDoubleClick="NearbyGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="NearbySsidColumn" Binding="{Binding Ssid}" Width="*" />
                                        <DataGridTextColumn x:Name="NearbySignalColumn" Binding="{Binding SignalPercent}" Width="82" />
                                        <DataGridTextColumn x:Name="NearbySecurityColumn" Binding="{Binding Authentication}" Width="140" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="10,0,0,0">
                            <DockPanel>
                                <TextBlock x:Name="PriorityListTitle" DockPanel.Dock="Top" />
                                <DataGrid x:Name="ProfileGrid" IsReadOnly="False" MouseDoubleClick="ProfileGrid_MouseDoubleClick" AllowDrop="True" PreviewMouseLeftButtonDown="ProfileGrid_PreviewMouseLeftButtonDown" MouseMove="ProfileGrid_MouseMove" Drop="ProfileGrid_Drop">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="ProfileDragColumn" Binding="{Binding DragHandle}" Width="42" IsReadOnly="True" />
                                        <DataGridTextColumn x:Name="ProfileSsidColumn" Binding="{Binding Ssid}" IsReadOnly="True" Width="*" />
                                        <DataGridTextColumn x:Name="ProfilePriorityColumn" Binding="{Binding Priority}" IsReadOnly="True" Width="74" />
                                        <DataGridCheckBoxColumn x:Name="ProfileCredentialColumn" Binding="{Binding CredentialSaved}" IsReadOnly="True" Width="88" />
                                        <DataGridCheckBoxColumn x:Name="ProfileEnabledColumn" Binding="{Binding Enabled}" IsReadOnly="False" Width="78" />
                                        <DataGridTextColumn x:Name="ProfileFailuresColumn" Binding="{Binding FailureCount}" IsReadOnly="True" Width="78" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="PolicyPanel" Visibility="Collapsed">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock x:Name="PolicyTitle" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IntervalLabel" VerticalAlignment="Center" />
                            <TextBox x:Name="IntervalTextBox" Grid.Column="1" />
                            <ComboBox x:Name="IntervalUnitComboBox" Grid.Column="2" Margin="8,0,0,0">
                                <ComboBoxItem Tag="1" />
                                <ComboBoxItem Tag="60" />
                                <ComboBoxItem Tag="3600" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FailuresBeforeRecoveryLabel" VerticalAlignment="Center" />
                            <TextBox x:Name="FailuresTextBox" Grid.Column="1" />
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CooldownLabel" VerticalAlignment="Center" />
                            <TextBox x:Name="CooldownTextBox" Grid.Column="1" />
                            <ComboBox x:Name="CooldownUnitComboBox" Grid.Column="2" Margin="8,0,0,0">
                                <ComboBoxItem Tag="1" />
                                <ComboBoxItem Tag="60" />
                                <ComboBoxItem Tag="3600" />
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="AutoSwitchCheckBox" Margin="0,7" />
                        <CheckBox x:Name="SoftReconnectCheckBox" Margin="0,7" />
                        <CheckBox x:Name="DnsFlushCheckBox" Margin="0,7" />
                        <Button x:Name="SavePolicyButton" HorizontalAlignment="Left" Margin="0,18,0,0" Click="SavePolicy_Click" />
                    </StackPanel>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="ToolsPanel" Visibility="Collapsed">
                    <StackPanel>
                        <Button x:Name="ToolsCheckButton" HorizontalAlignment="Left" Click="CheckNow_Click" />
                        <Button x:Name="ToolsScanButton" HorizontalAlignment="Left" Click="Scan_Click" />
                        <TextBlock x:Name="HighRiskText" TextWrapping="Wrap" Margin="0,18,0,0" />
                    </StackPanel>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="LogPanel" Visibility="Collapsed">
                    <TextBox x:Name="LogTextBox" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="SettingsPanel" Visibility="Collapsed">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock x:Name="SettingsTitle" />
                        <TextBlock x:Name="LanguageLabel" />
                        <ComboBox x:Name="LanguageComboBox" Margin="0,6,0,18" Width="240" HorizontalAlignment="Left" SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem Tag="zh-CN" />
                            <ComboBoxItem Tag="en-US" />
                        </ComboBox>
                        <TextBlock x:Name="TrayTitle" Margin="0,8,0,10" />
                        <TextBlock x:Name="CloseBehaviorLabel" />
                        <ComboBox x:Name="CloseBehaviorComboBox" Margin="0,6,0,14" Width="260" HorizontalAlignment="Left" SelectionChanged="CloseBehaviorComboBox_SelectionChanged">
                            <ComboBoxItem Tag="ask" />
                            <ComboBoxItem Tag="exit" />
                            <ComboBoxItem Tag="tray" />
                        </ComboBox>
                        <CheckBox x:Name="StartMonitoringOnLaunchCheckBox" Margin="0,7" Checked="SettingsCheckBox_Changed" Unchecked="SettingsCheckBox_Changed" />
                        <CheckBox x:Name="StartMinimizedToTrayCheckBox" Margin="0,7" Checked="SettingsCheckBox_Changed" Unchecked="SettingsCheckBox_Changed" />
                    </StackPanel>
                </Border>
            
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
