<ui:FluentWindow x:Class="NetGuardian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="NetGuardian"
        Icon="Assets/app.ico"
        Width="1180"
        Height="760"
        MinWidth="1040"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <ui:FluentWindow.Resources>
        <Style x:Key="SectionBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#151B14" />
            <Setter Property="BorderBrush" Value="#344034" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#10170F" />
            <Setter Property="Foreground" Value="#EAF2E6" />
            <Setter Property="BorderBrush" Value="#2D3A2C" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="GridCenteredHeaderStyle" TargetType="DataGridColumnHeader" BasedOn="{StaticResource GridHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="GridTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10,0" />
        </Style>
        <Style x:Key="GridCenteredTextStyle" TargetType="TextBlock" BasedOn="{StaticResource GridTextStyle}">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="GridRowStyle" TargetType="DataGridRow">
            <Setter Property="Height" Value="38" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="NetGuardian" Icon="Assets/app-icon-256.png" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:NavigationView Grid.Column="0" x:Name="RootNavigation" PaneDisplayMode="Left" IsPaneOpen="False" CompactPaneLength="56" OpenPaneLength="208" SelectionChanged="RootNavigation_SelectionChanged" IsBackButtonVisible="Collapsed">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem x:Name="StatusNavButton" Content="Status" Icon="{ui:SymbolIcon Home24}" Tag="StatusPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                    <ui:NavigationViewItem x:Name="WifiNavButton" Content="Wi-Fi" Icon="{ui:SymbolIcon WifiSettings20}" Tag="WifiPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                    <ui:NavigationViewItem x:Name="PolicyNavButton" Content="Policy" Icon="{ui:SymbolIcon Document24}" Tag="PolicyPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                    <ui:NavigationViewItem x:Name="ToolsNavButton" Content="Tools" Icon="{ui:SymbolIcon Wrench24}" Tag="ToolsPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                    <ui:NavigationViewItem x:Name="DnsNavButton" Content="DNS" Icon="{ui:SymbolIcon GlobeSearch20}" Tag="DnsPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                    <ui:NavigationViewItem x:Name="QualityNavButton" Content="Quality" Icon="{ui:SymbolIcon DesktopSignal24}" Tag="QualityPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                    <ui:NavigationViewItem x:Name="SpeedNavButton" Content="Speed" Icon="{ui:SymbolIcon DesktopSignal24}" Tag="SpeedPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                    <ui:NavigationViewItem x:Name="WebsiteNavButton" Content="Website" Icon="{ui:SymbolIcon GlobeSearch20}" Tag="WebsitePanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                    <ui:NavigationViewItem x:Name="IpInfoNavButton" Content="IP" Icon="{ui:SymbolIcon GlobeSearch20}" Tag="IpInfoPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                    <ui:NavigationViewItem x:Name="ReportNavButton" Content="Report" Icon="{ui:SymbolIcon Document24}" Tag="ReportPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                    <ui:NavigationViewItem x:Name="AdapterNavButton" Content="Adapter" Icon="{ui:SymbolIcon DesktopSignal24}" Tag="NetworkPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                    <ui:NavigationViewItem x:Name="LogNavButton" Content="Log" Icon="{ui:SymbolIcon Document24}" Tag="LogPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                </ui:NavigationView.MenuItems>
                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItem x:Name="SettingsNavButton" Content="Settings" Icon="{ui:SymbolIcon Settings24}" Tag="SettingsPanel" PreviewMouseLeftButtonUp="NavigationItem_PreviewMouseLeftButtonUp" />
                </ui:NavigationView.FooterMenuItems>
            </ui:NavigationView>

            <Grid Grid.Column="1" Margin="20,10,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Grid.Row="0" Margin="0,0,0,18" LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="PageTitleText" />
                    <TextBlock x:Name="PageSubtitleText" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="HeaderStatusPill" Background="#272C25" BorderBrush="#3A4037" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Red" Margin="0,0,8,0" />
                            <TextBlock x:Name="HeaderStateText" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="CheckNowButton" Click="CheckNow_Click" />
                    <Button x:Name="StartMonitorButton" Click="StartMonitor_Click" />
                    <Button x:Name="StopButton" Click="StopMonitor_Click" />
                </StackPanel>
            </DockPanel>

            

                <Grid Grid.Row="1">
                    <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="StatusPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Margin="0,0,12,12" Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock x:Name="HealthStateLabel" />
                            <TextBlock x:Name="HealthStateText" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,4,0,8" />
                            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Margin="6,0,6,12" Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock x:Name="MonitorStateLabel" />
                            <TextBlock x:Name="MonitorStateText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,12" />
                            <TextBlock x:Name="NextCheckLabel" />
                            <TextBlock x:Name="NextCheckText" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Margin="12,0,0,12" Style="{StaticResource SectionBorderStyle}">
                        <StackPanel>
                            <TextBlock x:Name="CurrentNetworkLabel" />
                            <TextBlock x:Name="CurrentSsidText" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,12" />
                            <TextBlock x:Name="FailureStreakLabel" />
                            <TextBlock x:Name="FailureStreakText" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Margin="0,0,12,0" Style="{StaticResource SectionBorderStyle}">
                            <DockPanel>
                                <TextBlock x:Name="ProbeTitleText" DockPanel.Dock="Top" />
                                <DataGrid x:Name="ProbeGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="ProbeNameColumn" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource GridTextStyle}" />
                                        <DataGridTextColumn x:Name="ProbeOkColumn" Binding="{Binding ResultText}" Width="90" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                        <DataGridTextColumn x:Name="ProbeLatencyColumn" Binding="{Binding LatencyText}" Width="110" ElementStyle="{StaticResource GridTextStyle}" />
                                        <DataGridTextColumn x:Name="ProbeDetailColumn" Binding="{Binding Detail}" Width="3*" ElementStyle="{StaticResource GridTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="12,0,0,0" Style="{StaticResource SectionBorderStyle}">
                            <DockPanel>
                                <TextBlock x:Name="RecentEventsTitle" DockPanel.Dock="Top" />
                                <ListBox x:Name="RecentEventsList" BorderThickness="0" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="WifiPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="0,0,0,8">
                        <Button x:Name="ScanButton" Click="Scan_Click" Margin="0,0,6,6" />
                        <Button x:Name="AddSelectedButton" Click="AddSelected_Click" Margin="0,0,6,6" />
                        <Button x:Name="SetPasswordButton" Click="SetPassword_Click" Margin="0,0,6,6" />
                        <Button x:Name="AddManualButton" Click="AddManual_Click" Margin="0,0,6,6" />
                        <Button x:Name="MoveUpButton" Click="MoveUp_Click" Margin="0,0,6,6" />
                        <Button x:Name="MoveDownButton" Click="MoveDown_Click" Margin="0,0,6,6" />
                        <Button x:Name="RemoveButton" Click="Remove_Click" Margin="0,0,6,6" />
                        <Button x:Name="ConnectButton" Click="Connect_Click" Margin="0,0,6,6" />
                    </WrapPanel>
                    <TextBlock x:Name="DragHintText" Grid.Row="1" Margin="0,0,0,12" Opacity="0.72" TextWrapping="Wrap" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1.25*" />
                        </Grid.ColumnDefinitions>
                        <Border Margin="0,0,10,0" Style="{StaticResource SectionBorderStyle}">
                            <DockPanel>
                                <TextBlock x:Name="NearbyNetworksTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <DataGrid x:Name="NearbyGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38" MouseDoubleClick="NearbyGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="NearbySsidColumn" Binding="{Binding Ssid}" Width="*" ElementStyle="{StaticResource GridTextStyle}" />
                                        <DataGridTextColumn x:Name="NearbySignalColumn" Binding="{Binding SignalPercent}" Width="82" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                        <DataGridTextColumn x:Name="NearbySecurityColumn" Binding="{Binding Authentication}" Width="140" ElementStyle="{StaticResource GridTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource SectionBorderStyle}">
                            <DockPanel>
                                <TextBlock x:Name="PriorityListTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,10" />
                                <DataGrid x:Name="ProfileGrid" AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38" MouseDoubleClick="ProfileGrid_MouseDoubleClick" AllowDrop="True" PreviewMouseLeftButtonDown="ProfileGrid_PreviewMouseLeftButtonDown" MouseMove="ProfileGrid_MouseMove" Drop="ProfileGrid_Drop">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="ProfileDragColumn" Binding="{Binding DragHandle}" Width="42" IsReadOnly="True" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                        <DataGridTextColumn x:Name="ProfileSsidColumn" Binding="{Binding Ssid}" IsReadOnly="True" Width="*" ElementStyle="{StaticResource GridTextStyle}" />
                                        <DataGridTextColumn x:Name="ProfilePriorityColumn" Binding="{Binding Priority}" IsReadOnly="True" Width="74" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                        <DataGridTemplateColumn x:Name="ProfileCredentialColumn" IsReadOnly="True" Width="88" HeaderStyle="{StaticResource GridCenteredHeaderStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:ToggleSwitch IsChecked="{Binding CredentialSaved}" IsEnabled="False" HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn x:Name="ProfileEnabledColumn" Width="78" HeaderStyle="{StaticResource GridCenteredHeaderStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ui:ToggleSwitch IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Checked="ProfileEnabledToggle_Changed" Unchecked="ProfileEnabledToggle_Changed" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn x:Name="ProfileFailuresColumn" Binding="{Binding FailureCount}" IsReadOnly="True" Width="88" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="PolicyPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock x:Name="PolicyTitle" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IntervalLabel" VerticalAlignment="Center" />
                            <TextBox x:Name="IntervalTextBox" Grid.Column="1" />
                            <ComboBox x:Name="IntervalUnitComboBox" Grid.Column="2" Margin="8,0,0,0">
                                <ComboBoxItem Tag="1" />
                                <ComboBoxItem Tag="60" />
                                <ComboBoxItem Tag="3600" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FailuresBeforeRecoveryLabel" VerticalAlignment="Center" />
                            <TextBox x:Name="FailuresTextBox" Grid.Column="1" />
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CooldownLabel" VerticalAlignment="Center" />
                            <TextBox x:Name="CooldownTextBox" Grid.Column="1" />
                            <ComboBox x:Name="CooldownUnitComboBox" Grid.Column="2" Margin="8,0,0,0">
                                <ComboBoxItem Tag="1" />
                                <ComboBoxItem Tag="60" />
                                <ComboBoxItem Tag="3600" />
                            </ComboBox>
                        </Grid>
                        <ui:ToggleSwitch x:Name="AutoSwitchCheckBox" Margin="0,9" />
                        <ui:ToggleSwitch x:Name="SoftReconnectCheckBox" Margin="0,9" />
                        <ui:ToggleSwitch x:Name="DnsFlushCheckBox" Margin="0,9" />
                        <Button x:Name="SavePolicyButton" HorizontalAlignment="Left" Margin="0,18,0,0" Click="SavePolicy_Click" />
                    </StackPanel>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="ToolsPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="ToolsTitle" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button x:Name="ToolsCheckButton" Click="CheckNow_Click" Margin="0,0,8,8" />
                            <Button x:Name="ToolsScanButton" Click="Scan_Click" Margin="0,0,8,8" />
                            <Button x:Name="ToolsNetworkSettingsButton" Click="ToolsNetworkSettings_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock x:Name="HighRiskText" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.74" />
                        <TextBlock x:Name="ToolsOutputText" Margin="0,14,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="DnsPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="DnsToolsTitle" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <WrapPanel Margin="0,0,0,8">
                            <Button x:Name="DnsRefreshButton" Click="DnsRefresh_Click" Margin="0,0,8,8" />
                            <Button x:Name="DnsFlushButton" Click="ToolsFlushDns_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="DnsAdapterComboBox" Grid.Column="0" Margin="0,0,8,0" SelectionChanged="DnsAdapterComboBox_SelectionChanged" />
                            <ComboBox x:Name="DnsPresetComboBox" Grid.Column="1" Margin="0,0,8,0" SelectionChanged="DnsPresetComboBox_SelectionChanged">
                                <ComboBoxItem Tag="automatic" />
                                <ComboBoxItem Tag="ali" />
                                <ComboBoxItem Tag="tencent" />
                                <ComboBoxItem Tag="cloudflare" />
                                <ComboBoxItem Tag="google" />
                                <ComboBoxItem Tag="custom" />
                            </ComboBox>
                            <TextBox x:Name="DnsPrimaryTextBox" Grid.Column="2" Margin="0,0,8,0" />
                            <TextBox x:Name="DnsSecondaryTextBox" Grid.Column="3" Margin="0,0,8,0" />
                            <Button x:Name="DnsApplyButton" Grid.Column="4" Click="DnsApply_Click" />
                        </Grid>
                        <TextBlock x:Name="DnsToolsHint" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.74" />
                        <TextBlock x:Name="DnsStatusText" Margin="0,14,0,10" TextWrapping="Wrap" />
                        <DataGrid x:Name="DnsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38" MinHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="DnsAdapterColumn" Binding="{Binding Adapter}" Width="2*" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="DnsServersColumn" Binding="{Binding Servers}" Width="2*" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="DnsSourceColumn" Binding="{Binding Source}" Width="120" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                <DataGridTextColumn x:Name="DnsStatusColumn" Binding="{Binding Status}" Width="120" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="QualityPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="QualityToolsTitle" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button x:Name="QualityRunButton" Click="QualityRun_Click" Margin="0,0,8,8" />
                            <Button x:Name="QualityOpenSettingsButton" Click="ToolsNetworkSettings_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                        <Grid Margin="0,8,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="QualityScoreLabel" />
                                <TextBlock x:Name="QualityScoreText" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="QualityLatencyLabel" />
                                <TextBlock x:Name="QualityLatencyText" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="QualityStateLabel" />
                                <TextBlock x:Name="QualityStateText" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="QualityStatusText" Margin="0,0,0,10" TextWrapping="Wrap" />
                        <DataGrid x:Name="QualityProbeGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38" MinHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="QualityProbeColumn" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="QualityResultColumn" Binding="{Binding ResultText}" Width="110" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                <DataGridTextColumn x:Name="QualityLatencyColumn" Binding="{Binding LatencyText}" Width="130" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="QualityDetailColumn" Binding="{Binding Detail}" Width="3*" ElementStyle="{StaticResource GridTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="SpeedPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="SpeedToolsTitle" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button x:Name="SpeedRunButton" Click="SpeedRun_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                        <Grid Margin="0,8,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock x:Name="DownloadSpeedLabel" />
                                <TextBlock x:Name="DownloadSpeedText" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                <TextBlock x:Name="UploadSpeedLabel" />
                                <TextBlock x:Name="UploadSpeedText" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock x:Name="SpeedLatencyLabel" />
                                <TextBlock x:Name="SpeedLatencyText" FontSize="28" FontWeight="Bold" Margin="0,6,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="SpeedStatusText" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="WebsitePanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="WebsiteToolsTitle" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WebsiteUrlTextBox" Margin="0,0,8,0" />
                            <Button x:Name="WebsiteRunButton" Grid.Column="1" Click="WebsiteRun_Click" />
                        </Grid>
                        <WrapPanel Margin="0,0,0,12">
                            <Button x:Name="WebsiteAppleButton" Tag="https://www.apple.com/" Click="WebsitePreset_Click" Margin="0,0,8,8" />
                            <Button x:Name="WebsiteGitHubButton" Tag="https://github.com/" Click="WebsitePreset_Click" Margin="0,0,8,8" />
                            <Button x:Name="WebsiteGoogleButton" Tag="https://www.google.com/" Click="WebsitePreset_Click" Margin="0,0,8,8" />
                            <Button x:Name="WebsiteYouTubeButton" Tag="https://www.youtube.com/" Click="WebsitePreset_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock x:Name="WebsiteStatusText" Margin="0,0,0,10" TextWrapping="Wrap" />
                        <DataGrid x:Name="WebsiteGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38" MinHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="WebsiteNameColumn" Binding="{Binding Name}" Width="130" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="WebsiteStatusColumn" Binding="{Binding Status}" Width="100" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                <DataGridTextColumn x:Name="WebsiteHttpColumn" Binding="{Binding HttpStatus}" Width="110" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="WebsiteDnsColumn" Binding="{Binding DnsLatency}" Width="120" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="WebsiteLatencyColumn" Binding="{Binding HttpLatency}" Width="120" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="WebsiteAddressColumn" Binding="{Binding Address}" Width="150" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="WebsiteDetailColumn" Binding="{Binding Detail}" Width="2*" ElementStyle="{StaticResource GridTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="IpInfoPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="IpInfoToolsTitle" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button x:Name="IpInfoRefreshButton" Click="IpInfoRefresh_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock x:Name="IpInfoStatusText" Margin="0,4,0,10" TextWrapping="Wrap" />
                        <DataGrid x:Name="IpInfoGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38" MinHeight="340">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="IpInfoNameColumn" Binding="{Binding Name}" Width="180" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="IpInfoValueColumn" Binding="{Binding Value}" Width="*" ElementStyle="{StaticResource GridTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="ReportPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="ReportToolsTitle" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button x:Name="ReportRunButton" Click="ReportRun_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock x:Name="ReportStatusText" Margin="0,4,0,10" TextWrapping="Wrap" />
                        <DataGrid x:Name="ReportGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38" MinHeight="340">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="ReportItemColumn" Binding="{Binding Item}" Width="180" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="ReportResultColumn" Binding="{Binding Result}" Width="180" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="ReportAdviceColumn" Binding="{Binding Advice}" Width="*" ElementStyle="{StaticResource GridTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="NetworkPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel>
                        <TextBlock x:Name="AdapterToolsTitle" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <WrapPanel>
                            <Button x:Name="AdapterRefreshButton" Click="AdapterRefresh_Click" Margin="0,0,8,8" />
                            <Button x:Name="AdapterRenewDhcpButton" Click="ToolsRenewDhcp_Click" Margin="0,0,8,8" />
                            <Button x:Name="AdapterSettingsButton" Click="ToolsNetworkSettings_Click" Margin="0,0,8,8" />
                        </WrapPanel>
                        <TextBlock x:Name="AdapterToolsHint" TextWrapping="Wrap" Margin="0,10,0,0" Opacity="0.74" />
                        <TextBlock x:Name="AdapterStatusText" Margin="0,14,0,10" TextWrapping="Wrap" />
                        <DataGrid x:Name="AdapterGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" RowStyle="{StaticResource GridRowStyle}" ColumnHeaderStyle="{StaticResource GridHeaderStyle}" ColumnHeaderHeight="38" MinHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="AdapterNameColumn" Binding="{Binding Name}" Width="1.8*" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="AdapterTypeColumn" Binding="{Binding Type}" Width="130" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="AdapterStatusColumn" Binding="{Binding Status}" Width="110" ElementStyle="{StaticResource GridCenteredTextStyle}" HeaderStyle="{StaticResource GridCenteredHeaderStyle}" />
                                <DataGridTextColumn x:Name="AdapterIpv4Column" Binding="{Binding Ipv4}" Width="150" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="AdapterGatewayColumn" Binding="{Binding Gateway}" Width="150" ElementStyle="{StaticResource GridTextStyle}" />
                                <DataGridTextColumn x:Name="AdapterDnsColumn" Binding="{Binding DnsServers}" Width="2*" ElementStyle="{StaticResource GridTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="LogPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <TextBox x:Name="LogTextBox" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </Border>

                <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="SettingsPanel" Visibility="Collapsed" Style="{StaticResource SectionBorderStyle}">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock x:Name="SettingsTitle" />
                        <Grid Margin="0,12,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LanguageLabel" VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="240" HorizontalAlignment="Left" SelectionChanged="LanguageComboBox_SelectionChanged">
                                <ComboBoxItem Tag="zh-CN" />
                                <ComboBoxItem Tag="en-US" />
                            </ComboBox>
                        </Grid>
                        <TextBlock x:Name="TrayTitle" Margin="0,8,0,10" />
                        <TextBlock x:Name="CloseBehaviorLabel" />
                        <ComboBox x:Name="CloseBehaviorComboBox" Margin="0,6,0,14" Width="260" HorizontalAlignment="Left" SelectionChanged="CloseBehaviorComboBox_SelectionChanged">
                            <ComboBoxItem Tag="ask" />
                            <ComboBoxItem Tag="exit" />
                            <ComboBoxItem Tag="tray" />
                        </ComboBox>
                        <ui:ToggleSwitch x:Name="StartMonitoringOnLaunchCheckBox" Margin="0,9" Checked="SettingsCheckBox_Changed" Unchecked="SettingsCheckBox_Changed" />
                        <ui:ToggleSwitch x:Name="StartMinimizedToTrayCheckBox" Margin="0,9" Checked="SettingsCheckBox_Changed" Unchecked="SettingsCheckBox_Changed" />
                    </StackPanel>
                </Border>
            
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
