<Window x:Class="NetGuardian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetGuardian"
        Icon="Assets/app.ico"
        Width="1180"
        Height="760"
        MinWidth="1040"
        MinHeight="660"
        Background="#EEF3F8"
        FontFamily="Segoe UI"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#14202B" />
        <SolidColorBrush x:Key="Muted" Color="#637083" />
        <SolidColorBrush x:Key="Line" Color="#DCE5EE" />
        <SolidColorBrush x:Key="Panel" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Primary" Color="#176B87" />
        <SolidColorBrush x:Key="PrimaryDark" Color="#0F4153" />
        <SolidColorBrush x:Key="Success" Color="#16885F" />
        <SolidColorBrush x:Key="Warning" Color="#B7791F" />
        <SolidColorBrush x:Key="Danger" Color="#B42318" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CAD6E2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="#E8F1F5" />
            <Setter Property="Background" Value="#122431" />
            <Setter Property="BorderBrush" Value="#122431" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderBrush" Value="#C9D6E2" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="40" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF3F8" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F7FAFD" />
            <Setter Property="Foreground" Value="#425466" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#122431">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,22">
                        <Image Source="Assets/app-icon-256.png" Width="36" Height="36" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock x:Name="AppTitleText" Text="NetGuardian" Foreground="White" FontSize="21" FontWeight="Bold" />
                            <TextBlock Text="Wi-Fi Recovery" Foreground="#8FA7B7" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="StatusNavButton" Style="{StaticResource NavButton}" Click="ShowStatus_Click" />
                    <Button x:Name="WifiNavButton" Style="{StaticResource NavButton}" Click="ShowWifi_Click" />
                    <Button x:Name="PolicyNavButton" Style="{StaticResource NavButton}" Click="ShowPolicy_Click" />
                    <Button x:Name="ToolsNavButton" Style="{StaticResource NavButton}" Click="ShowTools_Click" />
                    <Button x:Name="LogNavButton" Style="{StaticResource NavButton}" Click="ShowLog_Click" />
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Click="ShowSettings_Click" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Background="#173346" CornerRadius="8" Padding="12">
                    <StackPanel>
                        <TextBlock x:Name="SidebarStateLabel" Foreground="#9BB1C0" FontSize="12" />
                        <TextBlock x:Name="SidebarStateText" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitle}" />
                    <TextBlock x:Name="PageSubtitleText" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CheckNowButton" Click="CheckNow_Click" />
                    <Button x:Name="StartMonitorButton" Style="{StaticResource PrimaryButton}" Click="StartMonitor_Click" />
                    <Button x:Name="StopButton" Click="StopMonitor_Click" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid x:Name="StatusPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock x:Name="HealthStateLabel" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="HealthStateText" FontSize="34" FontWeight="Bold" Foreground="{StaticResource Primary}" Margin="0,4,0,8" />
                            <TextBlock x:Name="SummaryText" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Column="1" Margin="6,0,6,12">
                        <StackPanel>
                            <TextBlock x:Name="MonitorStateLabel" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="MonitorStateText" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,12" />
                            <TextBlock x:Name="NextCheckLabel" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="NextCheckText" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Grid.Column="2" Margin="12,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="CurrentNetworkLabel" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="CurrentSsidText" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,12" />
                            <TextBlock x:Name="FailureStreakLabel" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="FailureStreakText" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="1" Grid.ColumnSpan="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <DockPanel>
                                <TextBlock x:Name="ProbeTitleText" Style="{StaticResource CardTitle}" DockPanel.Dock="Top" />
                                <DataGrid x:Name="ProbeGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="ProbeNameColumn" Binding="{Binding Name}" Width="2*" />
                                        <DataGridTextColumn x:Name="ProbeOkColumn" Binding="{Binding Ok}" Width="80" />
                                        <DataGridTextColumn x:Name="ProbeLatencyColumn" Binding="{Binding LatencyText}" Width="110" />
                                        <DataGridTextColumn x:Name="ProbeDetailColumn" Binding="{Binding Detail}" Width="3*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Grid.Column="1" Margin="12,0,0,0">
                            <DockPanel>
                                <TextBlock x:Name="RecentEventsTitle" Style="{StaticResource CardTitle}" DockPanel.Dock="Top" />
                                <ListBox x:Name="RecentEventsList" BorderThickness="0" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="WifiPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock x:Name="DragHintText" Style="{StaticResource MutedText}" DockPanel.Dock="Right" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Click="Scan_Click" />
                            <Button x:Name="AddSelectedButton" Click="AddSelected_Click" />
                            <Button x:Name="AddManualButton" Click="AddManual_Click" />
                            <Button x:Name="MoveUpButton" Click="MoveUp_Click" />
                            <Button x:Name="MoveDownButton" Click="MoveDown_Click" />
                            <Button x:Name="RemoveButton" Click="Remove_Click" />
                            <Button x:Name="ConnectButton" Click="Connect_Click" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1.25*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                            <DockPanel>
                                <TextBlock x:Name="NearbyNetworksTitle" Style="{StaticResource CardTitle}" DockPanel.Dock="Top" />
                                <DataGrid x:Name="NearbyGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="NearbySsidColumn" Binding="{Binding Ssid}" Width="*" />
                                        <DataGridTextColumn x:Name="NearbySignalColumn" Binding="{Binding SignalPercent}" Width="82" />
                                        <DataGridTextColumn x:Name="NearbySecurityColumn" Binding="{Binding Authentication}" Width="140" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Grid.Column="1" Margin="10,0,0,0">
                            <DockPanel>
                                <TextBlock x:Name="PriorityListTitle" Style="{StaticResource CardTitle}" DockPanel.Dock="Top" />
                                <DataGrid x:Name="ProfileGrid"
                                          AllowDrop="True"
                                          PreviewMouseLeftButtonDown="ProfileGrid_PreviewMouseLeftButtonDown"
                                          MouseMove="ProfileGrid_MouseMove"
                                          Drop="ProfileGrid_Drop">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="ProfileDragColumn" Binding="{Binding DragHandle}" Width="42" IsReadOnly="True" />
                                        <DataGridTextColumn x:Name="ProfileSsidColumn" Binding="{Binding Ssid}" Width="*" />
                                        <DataGridTextColumn x:Name="ProfilePriorityColumn" Binding="{Binding Priority}" Width="74" />
                                        <DataGridCheckBoxColumn x:Name="ProfileCredentialColumn" Binding="{Binding CredentialSaved}" IsReadOnly="True" Width="88" />
                                        <DataGridCheckBoxColumn x:Name="ProfileEnabledColumn" Binding="{Binding Enabled}" Width="78" />
                                        <DataGridTextColumn x:Name="ProfileFailuresColumn" Binding="{Binding FailureCount}" Width="78" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Border x:Name="PolicyPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock x:Name="PolicyTitle" Style="{StaticResource CardTitle}" />
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="IntervalLabel" VerticalAlignment="Center" />
                            <TextBox x:Name="IntervalTextBox" Grid.Column="1" />
                            <ComboBox x:Name="IntervalUnitComboBox" Grid.Column="2" Margin="8,0,0,0">
                                <ComboBoxItem Tag="1" />
                                <ComboBoxItem Tag="60" />
                                <ComboBoxItem Tag="3600" />
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FailuresBeforeRecoveryLabel" VerticalAlignment="Center" />
                            <TextBox x:Name="FailuresTextBox" Grid.Column="1" />
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="CooldownLabel" VerticalAlignment="Center" />
                            <TextBox x:Name="CooldownTextBox" Grid.Column="1" />
                            <ComboBox x:Name="CooldownUnitComboBox" Grid.Column="2" Margin="8,0,0,0">
                                <ComboBoxItem Tag="1" />
                                <ComboBoxItem Tag="60" />
                                <ComboBoxItem Tag="3600" />
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="AutoSwitchCheckBox" Margin="0,7" />
                        <CheckBox x:Name="SoftReconnectCheckBox" Margin="0,7" />
                        <CheckBox x:Name="DnsFlushCheckBox" Margin="0,7" />
                        <Button x:Name="SavePolicyButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0" Click="SavePolicy_Click" />
                    </StackPanel>
                </Border>

                <Border x:Name="ToolsPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel>
                        <Button x:Name="ToolsCheckButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="CheckNow_Click" />
                        <Button x:Name="ToolsScanButton" HorizontalAlignment="Left" Click="Scan_Click" />
                        <TextBlock x:Name="HighRiskText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,18,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="LogPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                    <TextBox x:Name="LogTextBox" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </Border>

                <Border x:Name="SettingsPanel" Style="{StaticResource Card}" Visibility="Collapsed">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock x:Name="SettingsTitle" Style="{StaticResource CardTitle}" />
                        <TextBlock x:Name="LanguageLabel" />
                        <ComboBox x:Name="LanguageComboBox" Margin="0,6,0,18" Width="240" HorizontalAlignment="Left" SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem Tag="zh-CN" />
                            <ComboBoxItem Tag="en-US" />
                        </ComboBox>
                        <TextBlock x:Name="TrayTitle" Style="{StaticResource CardTitle}" Margin="0,8,0,10" />
                        <TextBlock x:Name="CloseBehaviorLabel" />
                        <ComboBox x:Name="CloseBehaviorComboBox" Margin="0,6,0,14" Width="260" HorizontalAlignment="Left" SelectionChanged="CloseBehaviorComboBox_SelectionChanged">
                            <ComboBoxItem Tag="ask" />
                            <ComboBoxItem Tag="exit" />
                            <ComboBoxItem Tag="tray" />
                        </ComboBox>
                        <CheckBox x:Name="StartMonitoringOnLaunchCheckBox" Margin="0,7" Checked="SettingsCheckBox_Changed" Unchecked="SettingsCheckBox_Changed" />
                        <CheckBox x:Name="StartMinimizedToTrayCheckBox" Margin="0,7" Checked="SettingsCheckBox_Changed" Unchecked="SettingsCheckBox_Changed" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
