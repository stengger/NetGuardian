                                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                            <Border Padding="{DynamicResource SpacingCompactInset}" Margin="{DynamicResource SpacingIconPadding}" CornerRadius="{DynamicResource CornerControl}" BorderThickness="{DynamicResource StrokeControlThickness}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style><Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource StatusInfoBrush}" />
                                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusInfoBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Warning"><Setter Property="BorderBrush" Value="{DynamicResource StatusWarningBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource StatusWarningBrush}" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Error"><Setter Property="BorderBrush" Value="{DynamicResource StatusDangerBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource StatusDangerBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style></Border.Style>
