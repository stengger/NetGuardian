<Window x:Class="NetGuardian.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetGuardian"
        Width="1120"
        Height="720"
        MinWidth="980"
        MinHeight="620"
        Background="#F4F7FB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderBrush" Value="#C9D3E0" />
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#216869" />
            <Setter Property="BorderBrush" Value="#216869" />
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Foreground" Value="#EAF2F2" />
            <Setter Property="Background" Value="#1F2933" />
            <Setter Property="BorderBrush" Value="#1F2933" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#172026" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#667085" />
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#DFE7F1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DFE7F1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="36" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F6" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1F2933">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock x:Name="AppTitleText" Text="NetGuardian" Foreground="White" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Wi-Fi Recovery" Foreground="#A7B5C5" Margin="0,4,0,18" />
                    <Button x:Name="StatusNavButton" Style="{StaticResource NavButton}" Click="ShowStatus_Click" />
                    <Button x:Name="WifiNavButton" Style="{StaticResource NavButton}" Click="ShowWifi_Click" />
                    <Button x:Name="PolicyNavButton" Style="{StaticResource NavButton}" Click="ShowPolicy_Click" />
                    <Button x:Name="ToolsNavButton" Style="{StaticResource NavButton}" Click="ShowTools_Click" />
                    <Button x:Name="LogNavButton" Style="{StaticResource NavButton}" Click="ShowLog_Click" />
                    <Button x:Name="SettingsNavButton" Style="{StaticResource NavButton}" Click="ShowSettings_Click" />
                </StackPanel>
                <TextBlock x:Name="FooterText" DockPanel.Dock="Bottom" Text="C# / WPF" Foreground="#7B8794" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="PageTitleText" Style="{StaticResource SectionTitle}" Text="状态" />
                    <TextBlock x:Name="PageSubtitleText" Style="{StaticResource MutedText}" Text="网络健康与恢复概览" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CheckNowButton" Style="{StaticResource PrimaryButton}" Click="CheckNow_Click" />
                    <Button x:Name="StartMonitorButton" Click="StartMonitor_Click" />
                    <Button x:Name="StopButton" Click="StopMonitor_Click" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid x:Name="StatusPanel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardBorder}" Grid.Column="0" Margin="0,0,12,12">
                        <StackPanel>
                            <TextBlock x:Name="HealthStateLabel" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="HealthStateText" Text="尚未检测" FontSize="36" FontWeight="Bold" Foreground="#216869" Margin="0,4,0,8" />
                            <TextBlock x:Name="SummaryText" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Grid.Column="1" Margin="12,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="CurrentNetworkLabel" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="CurrentSsidText" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,12" />
                            <TextBlock x:Name="LastCheckLabel" Style="{StaticResource MutedText}" />
                            <TextBlock x:Name="LastCheckText" FontSize="16" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Grid.Row="1" Grid.ColumnSpan="2">
                        <DataGrid x:Name="ProbeGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Probe" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="OK" Binding="{Binding Ok}" Width="80" />
                                <DataGridTextColumn Header="Latency" Binding="{Binding LatencyText}" Width="120" />
                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <Grid x:Name="WifiPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="ScanButton" Style="{StaticResource PrimaryButton}" Click="Scan_Click" />
                        <Button x:Name="AddSelectedButton" Click="AddSelected_Click" />
                        <Button x:Name="AddManualButton" Click="AddManual_Click" />
                        <Button x:Name="MoveUpButton" Click="MoveUp_Click" />
                        <Button x:Name="MoveDownButton" Click="MoveDown_Click" />
                        <Button x:Name="ConnectButton" Click="Connect_Click" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                            <DockPanel>
                                <TextBlock x:Name="NearbyNetworksTitle" Style="{StaticResource SectionTitle}" DockPanel.Dock="Top" Margin="0,0,0,12" />
                                <DataGrid x:Name="NearbyGrid" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="NearbySsidColumn" Header="SSID" Binding="{Binding Ssid}" Width="*" />
                                        <DataGridTextColumn x:Name="NearbySignalColumn" Header="Signal" Binding="{Binding SignalPercent}" Width="80" />
                                        <DataGridTextColumn x:Name="NearbySecurityColumn" Header="Security" Binding="{Binding Authentication}" Width="140" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Grid.Column="1" Margin="10,0,0,0">
                            <DockPanel>
                                <TextBlock x:Name="PriorityListTitle" Style="{StaticResource SectionTitle}" DockPanel.Dock="Top" Margin="0,0,0,12" />
                                <DataGrid x:Name="ProfileGrid" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="ProfileSsidColumn" Header="SSID" Binding="{Binding Ssid}" Width="*" />
                                        <DataGridTextColumn x:Name="ProfilePriorityColumn" Header="Priority" Binding="{Binding Priority}" Width="80" />
                                        <DataGridCheckBoxColumn x:Name="ProfileEnabledColumn" Header="Enabled" Binding="{Binding Enabled}" Width="90" />
                                        <DataGridTextColumn x:Name="ProfileFailuresColumn" Header="Failures" Binding="{Binding FailureCount}" Width="90" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Border x:Name="PolicyPanel" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock x:Name="PolicyTitle" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />
                        <TextBlock x:Name="IntervalLabel" />
                        <TextBox x:Name="IntervalTextBox" Margin="0,4,0,12" />
                        <TextBlock x:Name="FailuresBeforeRecoveryLabel" />
                        <TextBox x:Name="FailuresTextBox" Margin="0,4,0,12" />
                        <TextBlock x:Name="CooldownLabel" />
                        <TextBox x:Name="CooldownTextBox" Margin="0,4,0,12" />
                        <CheckBox x:Name="AutoSwitchCheckBox" Margin="0,6" />
                        <CheckBox x:Name="SoftReconnectCheckBox" Margin="0,6" />
                        <CheckBox x:Name="DnsFlushCheckBox" Margin="0,6" />
                        <Button x:Name="SavePolicyButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0" Click="SavePolicy_Click" />
                    </StackPanel>
                </Border>

                <Border x:Name="ToolsPanel" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                    <StackPanel>
                        <Button x:Name="ToolsCheckButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="CheckNow_Click" />
                        <Button x:Name="ToolsScanButton" HorizontalAlignment="Left" Click="Scan_Click" />
                        <TextBlock x:Name="HighRiskText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,18,0,0" />
                    </StackPanel>
                </Border>

                <Border x:Name="LogPanel" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                    <TextBox x:Name="LogTextBox" BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                </Border>

                <Border x:Name="SettingsPanel" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                    <StackPanel MaxWidth="420" HorizontalAlignment="Left">
                        <TextBlock x:Name="SettingsTitle" Style="{StaticResource SectionTitle}" Margin="0,0,0,16" />
                        <TextBlock x:Name="LanguageLabel" />
                        <ComboBox x:Name="LanguageComboBox" Margin="0,6,0,0" SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem Tag="zh-CN" />
                            <ComboBoxItem Tag="en-US" />
                        </ComboBox>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
