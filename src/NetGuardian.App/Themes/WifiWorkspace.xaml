<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:presentation="clr-namespace:NetGuardian.App.Presentation" xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Buttons.xaml" /><ResourceDictionary Source="Filters.xaml" /></ResourceDictionary.MergedDictionaries>
    <presentation:RowDetailsToggleConverter x:Key="WifiDetailsToggleConverter" />
    <!-- 列不是视觉元素，静态列令牌须在主窗口自身的资源树中可用。 -->
    <DataGridLength x:Key="WifiSignalColumnWidth">64</DataGridLength>
    <sys:Double x:Key="WifiSignalColumnMinimum">64</sys:Double>
    <DataGridLength x:Key="WifiSecurityColumnWidth">120</DataGridLength>
    <sys:Double x:Key="WifiSecurityColumnMinimum">120</sys:Double>
    <DataGridLength x:Key="WifiPriorityStateColumnWidth">80</DataGridLength>
    <sys:Double x:Key="WifiPriorityStateColumnMinimum">80</sys:Double>
    <DataTemplate x:Key="WifiCompactDetailsTemplate"><presentation:TableRowDetails IsCompact="True" /></DataTemplate>
    <Style x:Key="WifiDetailValueStyle" TargetType="TextBox">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
            <Grid>
                <ScrollViewer x:Name="PART_ContentHost" Opacity="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" />
                <TextBlock x:Name="DisplayText" Text="{TemplateBinding Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" IsHitTestVisible="False" />
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="PART_ContentHost" Property="Opacity" Value="1" />
                <Setter TargetName="DisplayText" Property="Visibility" Value="Collapsed" />
            </Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WifiStatusBadgeStyle" TargetType="Border">
        <Setter Property="Height" Value="{DynamicResource WifiStatusBadgeHeight}" />
        <Setter Property="Padding" Value="{DynamicResource WifiStatusBadgePadding}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerControl}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource FontCaption}" />
        <Setter Property="TextElement.FontWeight" Value="Normal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="WifiConnectedBadgeStyle" TargetType="Border" BasedOn="{StaticResource WifiStatusBadgeStyle}">
        <Setter Property="Background" Value="{DynamicResource WifiConnectedBadgeBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusHealthyBrush}" />
    </Style>
    <Style x:Key="WifiPriorityBadgeStyle" TargetType="Border" BasedOn="{StaticResource WifiStatusBadgeStyle}">
        <Setter Property="ToolTip" Value="{Binding PriorityBadge}" />
        <Style.Triggers><DataTrigger Binding="{Binding IsInPriorityList}" Value="True">
            <Setter Property="Background" Value="{DynamicResource WifiPriorityBadgeBrush}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusInfoBrush}" />
        </DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="WifiSummaryCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{DynamicResource StrokeControlThickness}" />
        <Setter Property="CornerRadius" Value="{DynamicResource CornerCard}" />
        <Setter Property="Padding" Value="{DynamicResource WifiSummaryPadding}" />
        <Setter Property="Margin" Value="{DynamicResource WifiSectionGap}" />
        <Setter Property="MaxHeight" Value="{DynamicResource WifiSummaryMaxHeight}" />
    </Style>
    <Style x:Key="WifiSummaryExpanderStyle" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="IsExpanded" Value="True" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ContentPresenter ContentSource="Header" MinHeight="22" />
                <ContentPresenter Grid.Row="1" ContentSource="Content" MinHeight="18" VerticalAlignment="Center" />
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WifiSearchToolStyle" TargetType="ui:TextBox" BasedOn="{StaticResource CompactFilterTextBoxStyle}">
        <Setter Property="Height" Value="{DynamicResource ToolbarControlHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource ToolbarControlHeight}" />
        <Setter Property="MinWidth" Value="128" />
    </Style>
    <Style x:Key="WifiSortToolStyle" TargetType="ComboBox" BasedOn="{StaticResource CompactFilterComboBoxStyle}">
        <Setter Property="Height" Value="{DynamicResource ToolbarControlHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource ToolbarControlHeight}" />
        <Setter Property="Width" Value="112" />
        <Setter Property="MinWidth" Value="112" />
    </Style>
    <Style x:Key="WifiEmptyStateStyle" TargetType="Border">
        <Setter Property="Padding" Value="{DynamicResource WifiSummaryPadding}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="WifiWorkspaceSplitterStyle" TargetType="GridSplitter">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonKeyboardFocusStyle}" />
        <Setter Property="AutomationProperties.Name" Value="{DynamicResource TableDetailLabel}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridSplitter">
            <Grid Background="{TemplateBinding Background}">
                <Border x:Name="Grip" Background="{DynamicResource CardStrokeColorDefaultBrush}" Width="2" Margin="8,0" CornerRadius="1" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="ResizeDirection" Value="Rows"><Setter TargetName="Grip" Property="Width" Value="Auto" /><Setter TargetName="Grip" Property="Height" Value="2" /><Setter TargetName="Grip" Property="Margin" Value="0,8" /></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource FocusRingBrush}" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WifiWorkspaceRowHeaderStyle" TargetType="DataGridRowHeader">
        <Setter Property="MinHeight" Value="{DynamicResource GridRowHeight}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridRowHeader">
            <ToggleButton Style="{DynamicResource ExpansionToggleStyle}" Height="{DynamicResource GridRowHeight}" VerticalAlignment="Top" ToolTip="{DynamicResource TableDetailLabel}" AutomationProperties.Name="{DynamicResource TableDetailLabel}" IsChecked="{Binding DetailsVisibility, RelativeSource={RelativeSource AncestorType=DataGridRow}, Converter={StaticResource WifiDetailsToggleConverter}, Mode=TwoWay}" />
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="WifiLastScanCaptionStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource FontCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Style.Triggers><DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
    </Style>
</ResourceDictionary>
