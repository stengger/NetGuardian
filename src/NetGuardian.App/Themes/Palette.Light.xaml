<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Custom semantic colors — light theme (U2 §3.3, pre-validated AA). -->
    <SolidColorBrush x:Key="StatusHealthyBrush" Color="#16713B" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#A16207" />
    <SolidColorBrush x:Key="StatusDangerBrush" Color="#C0355C" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StrokeInputBrush" Color="#8A94A2" />
    <SolidColorBrush x:Key="ChartAccentBrush" Color="#0D9488" />
    <!-- 方向颜色独立于健康和警告状态。 -->
    <SolidColorBrush x:Key="SpeedDownloadBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="SpeedUploadBrush" Color="#087F73" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#262563EB" />
    <SolidColorBrush x:Key="RowSelectionStrokeBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ChartTrackBrush" Color="#D5DAE1" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#18212B" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#485564" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E8EDF3" />
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerButtonBrush" Color="#B3294D" />
    <SolidColorBrush x:Key="DangerButtonTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DisabledControlBrush" Color="#E7EBEF" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6C7581" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF4DF" />
</ResourceDictionary>
