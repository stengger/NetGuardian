<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AppAccentColor">#2563EB</Color>
    <!-- Custom semantic colors — light theme (U2 §3.3, pre-validated AA). -->
    <SolidColorBrush x:Key="StatusHealthyBrush" Color="#16713B" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#A16207" />
    <SolidColorBrush x:Key="StatusDangerBrush" Color="#C0355C" />
    <SolidColorBrush x:Key="WifiDestructiveBrush" Color="#A1485C" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StrokeInputBrush" Color="#8A94A2" />
    <SolidColorBrush x:Key="ChartAccentBrush" Color="#0D9488" />
    <!-- 方向颜色独立于健康和警告状态。 -->
    <SolidColorBrush x:Key="SpeedDownloadBrush" Color="{DynamicResource AppAccentColor}" />
    <SolidColorBrush x:Key="SpeedUploadBrush" Color="#087F73" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#262563EB" />
    <SolidColorBrush x:Key="RowSelectionStrokeBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ChartTrackBrush" Color="#D5DAE1" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#18212B" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#485564" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="{DynamicResource AppAccentColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#E8EDF3" />
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="{DynamicResource AppAccentColor}" />
    <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerButtonBrush" Color="#B3294D" />
    <SolidColorBrush x:Key="DangerButtonTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DisabledControlBrush" Color="#E7EBEF" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6C7581" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{DynamicResource AppAccentColor}" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#FFF4DF" />
    <DropShadowEffect x:Key="FeedbackShadow" Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.10" />

    <!-- 应用与库控件共用强调色，高对比保留系统选择色。 -->
    <SolidColorBrush x:Key="PrimaryButtonBorderBrush" Color="{DynamicResource AppAccentColor}" />
    <SolidColorBrush x:Key="DangerButtonBorderBrush" Color="#B3294D" />
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="{DynamicResource AppAccentColor}" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="{DynamicResource AppAccentColor}" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="{DynamicResource AppAccentColor}" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="{DynamicResource AppAccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="{DynamicResource AppAccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="{DynamicResource AppAccentColor}" />
    <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="{DynamicResource AppAccentColor}" />
    <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="{DynamicResource AppAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="{DynamicResource AppAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="{DynamicResource AppAccentColor}" />
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="{DynamicResource AppAccentColor}" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonInteractionBrush" Color="#000000" />
</ResourceDictionary>
