<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Custom semantic colors — dark theme (U2 §3.3, pre-validated AA). -->
    <SolidColorBrush x:Key="StatusHealthyBrush" Color="#6CCB8A" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="StatusDangerBrush" Color="#F47289" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#272C33" />
    <SolidColorBrush x:Key="StrokeInputBrush" Color="#7A8694" />
    <SolidColorBrush x:Key="ChartAccentBrush" Color="#55E6D5" />
    <!-- 方向颜色独立于健康和警告状态。 -->
    <SolidColorBrush x:Key="SpeedDownloadBrush" Color="#6EA8FF" />
    <SolidColorBrush x:Key="SpeedUploadBrush" Color="#55E6D5" />
    <!-- Row selection: accent at 15% alpha. -->
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#266EA8FF" />
    <SolidColorBrush x:Key="RowSelectionStrokeBrush" Color="Transparent" />
    <!-- Chart secondary strokes (gauge track / hairline). -->
    <SolidColorBrush x:Key="ChartTrackBrush" Color="#3A424D" />
    <!-- 页面与交互语义集中定义，动态资源同时支持运行中切换主题。 -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#20242B" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#B7C0CC" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#6EA8FF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#343B45" />
    <SolidColorBrush x:Key="PrimaryButtonBrush" Color="#6EA8FF" />
    <SolidColorBrush x:Key="PrimaryButtonTextBrush" Color="#101820" />
    <SolidColorBrush x:Key="DangerButtonBrush" Color="#F47289" />
    <SolidColorBrush x:Key="DangerButtonTextBrush" Color="#101820" />
    <SolidColorBrush x:Key="DisabledControlBrush" Color="#30363E" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#8D98A5" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#99C2FF" />
    <SolidColorBrush x:Key="WarningSurfaceBrush" Color="#383025" />
</ResourceDictionary>
