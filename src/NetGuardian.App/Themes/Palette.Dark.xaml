<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Custom semantic colors — dark theme (U2 §3.3, pre-validated AA). -->
    <SolidColorBrush x:Key="StatusHealthyBrush" Color="#6EA8FF" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="StatusDangerBrush" Color="#F47289" />
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="#272C33" />
    <SolidColorBrush x:Key="StrokeInputBrush" Color="#7A8694" />
    <SolidColorBrush x:Key="ChartAccentBrush" Color="#55E6D5" />
    <!-- 方向颜色独立于健康和警告状态。 -->
    <SolidColorBrush x:Key="SpeedDownloadBrush" Color="#6EA8FF" />
    <SolidColorBrush x:Key="SpeedUploadBrush" Color="#55E6D5" />
    <!-- Row selection: accent at 15% alpha. -->
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#266EA8FF" />
    <!-- Chart secondary strokes (gauge track / hairline). -->
    <SolidColorBrush x:Key="ChartTrackBrush" Color="#3A424D" />
</ResourceDictionary>
