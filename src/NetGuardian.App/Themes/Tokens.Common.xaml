<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Expansion.xaml" /></ResourceDictionary.MergedDictionaries>
    <!-- Theme-independent design tokens (U2 §3.5). -->
    <!-- 中文明确采用简体 UI 字体，英文及数字保留 Segoe UI。 -->
    <FontFamily x:Key="AppFontFamily">Segoe UI, Microsoft YaHei UI, Microsoft YaHei</FontFamily>

    <!-- Type scale: 6 steps. -->
    <sys:Double x:Key="FontCaption">12</sys:Double>
    <sys:Double x:Key="FontBody">14</sys:Double>
    <sys:Double x:Key="FontSubtitle">20</sys:Double>
    <sys:Double x:Key="FontSection">16</sys:Double>
    <sys:Double x:Key="FontMetric">24</sys:Double>
    <sys:Double x:Key="FontTitle">28</sys:Double>
    <sys:Double x:Key="FontDisplay">34</sys:Double>

    <!-- Corner radii: 2 steps (2px accent bars stay as decorative exceptions). -->
    <CornerRadius x:Key="CornerControl">4</CornerRadius>
    <CornerRadius x:Key="CornerCard">8</CornerRadius>

    <!-- Spacing scale. -->
    <Thickness x:Key="SpacingCardPadding">16</Thickness>
    <Thickness x:Key="SpacingItemGap">0,0,8,8</Thickness>
    <Thickness x:Key="SpacingControlPadding">12,8</Thickness>
    <Thickness x:Key="SpacingSectionGap">0,0,0,24</Thickness>
    <Thickness x:Key="SpacingFieldGap">0,0,0,12</Thickness>
    <Thickness x:Key="SpacingInlineGap">0,0,8,0</Thickness>
    <sys:Double x:Key="ControlMinHeight">36</sys:Double>
    <sys:Double x:Key="ExpansionGlyphSize">16</sys:Double>
    <sys:Double x:Key="ExpansionHitSize">32</sys:Double>
    <sys:Double x:Key="ExpansionStrokeThickness">1.5</sys:Double>
    <GridLength x:Key="ExpansionColumnWidth">32</GridLength>
    <Duration x:Key="ExpansionAnimationDuration">0:0:0.15</Duration>
    <Thickness x:Key="StrokeControlThickness">1</Thickness>
    <Thickness x:Key="SpacingFocusInset">2</Thickness>
    <sys:Double x:Key="GridHeaderHeight">40</sys:Double>
    <sys:Double x:Key="GridRowHeight">40</sys:Double>
    <sys:Double x:Key="LatencyGatewayGood">20</sys:Double>
    <sys:Double x:Key="LatencyGatewayWarning">100</sys:Double>
    <sys:Double x:Key="LatencyDnsGood">100</sys:Double>
    <sys:Double x:Key="LatencyDnsWarning">300</sys:Double>
    <sys:Double x:Key="LatencyHttpsGood">300</sys:Double>
    <sys:Double x:Key="LatencyHttpsWarning">1000</sys:Double>
    <sys:Double x:Key="TrafficChartWidth">158</sys:Double>
    <sys:Double x:Key="TrafficChartHeight">56</sys:Double>
</ResourceDictionary>
